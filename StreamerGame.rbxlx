    camTitle.TextSize = 11
    camTitle.TextColor3 = Color3.fromRGB(240, 245, 255)
    camTitle.TextXAlignment = Enum.TextXAlignment.Left
    camTitle.Text = "📷 FACECAM 1080p 60FPS"
    camTitle.Parent = camHeader

    local camLiveTag = Instance.new("TextLabel")
    camLiveTag.Size = UDim2.new(0, 54, 0, 18)
    camLiveTag.Position = UDim2.new(1, -60, 0.5, -9)
    camLiveTag.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    camLiveTag.Font = Enum.Font.GothamBold
    camLiveTag.TextSize = 9
    camLiveTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    camLiveTag.Text = "🔴 REC"
    camLiveTag.Parent = camHeader
    local clCorner = Instance.new("UICorner"); clCorner.CornerRadius = UDim.new(0, 4); clCorner.Parent = camLiveTag

    -- Real Avatar Facecam Image
    local camImg = Instance.new("ImageLabel")
    camImg.Name = "WebcamImage"
    camImg.Size = UDim2.new(1, -16, 1, -78)
    camImg.Position = UDim2.new(0, 8, 0, 34)
    camImg.BackgroundColor3 = Color3.fromRGB(8, 10, 15)
    camImg.BorderSizePixel = 0
    camImg.ScaleType = Enum.ScaleType.Fit
    camImg.Parent = webcamArea
    local ciCorner = Instance.new("UICorner"); ciCorner.CornerRadius = UDim.new(0, 6); ciCorner.Parent = camImg

    -- Load real avatar headshot/bust thumbnail
    task.spawn(function()
        local thumbType = Enum.ThumbnailType.AvatarBust
        local thumbSize = Enum.ThumbnailSize.Size420x420
        local content, isReady = Players:GetUserThumbnailAsync(player.UserId, thumbType, thumbSize)
        if content and camImg.Parent ~= nil then
            camImg.Image = content
        end
    end)

    -- Bottom Streamer Banner (Username + Dynamic Mic Meter)
    local bottomBanner = Instance.new("Frame")
    bottomBanner.Size = UDim2.new(1, -16, 0, 34)
    bottomBanner.Position = UDim2.new(0, 8, 1, -40)
    bottomBanner.BackgroundColor3 = Color3.fromRGB(20, 24, 34)
    bottomBanner.BorderSizePixel = 0
    bottomBanner.Parent = webcamArea
    local bbCorner = Instance.new("UICorner"); bbCorner.CornerRadius = UDim.new(0, 6); bbCorner.Parent = bottomBanner

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.65, 0, 1, 0)
    nameLabel.Position = UDim2.new(0, 8, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 12
    nameLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Text = `👤 {player.DisplayName}`
    nameLabel.Parent = bottomBanner

    local micMeter = Instance.new("TextLabel")
    micMeter.Size = UDim2.new(0.35, -8, 1, 0)
    micMeter.Position = UDim2.new(0.65, 0, 0, 0)
    micMeter.BackgroundTransparency = 1
    micMeter.Font = Enum.Font.GothamBold
    micMeter.TextSize = 11
    micMeter.TextColor3 = Color3.fromRGB(46, 204, 113)
    micMeter.TextXAlignment = Enum.TextXAlignment.Right
    micMeter.Text = "🎙️ ▂▄▆█"
    micMeter.Parent = bottomBanner

    -- Animate mic VU meter and blinking REC dot
    webcamLoopThread = task.spawn(function()
        local patterns = { "🎙️ ▂▃", "🎙️ ▂▄▅", "🎙️ ▂▄▆█", "🎙️ ▂▄▅", "🎙️ ▂▃▄" }
        local pIdx = 1
        local blink = true
        while isLive and webcamArea.Parent ~= nil do
            task.wait(0.4)
            pIdx = (pIdx % #patterns) + 1
            if micMeter.Parent then
                micMeter.Text = patterns[pIdx]
            end
            blink = not blink
            if camLiveTag.Parent then
                camLiveTag.Visible = blink
            end
            if recDot.Parent then
                recDot.TextColor3 = blink and Color3.fromRGB(231, 76, 60) or Color3.fromRGB(100, 30, 30)
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- Зупинка та запуск стріму з вибором платформи та категорії
--------------------------------------------------------------------------------
local function stopStream(player: Player)
    isStreaming[player] = false
    activeStreamThreads[player] = nil
    pendingEventByPlayer[player] = nil

    unequipPhone(player)
    updateMonitorDisplay(false, nil, nil, player)

    player:SetAttribute("ActiveStreamPlatforms", "")
    player:SetAttribute("IsStreamingYouTube", false)
    player:SetAttribute("IsStreamingTwitch", false)
    player:SetAttribute("IsStreamingTikTok", false)
    player:SetAttribute("IsPCStream", false)
    player:SetAttribute("IsPhoneStream", false)

    if player.Character then
        updateOverhead(player.Character, player)
    end

    if player.Parent ~= nil then
        streamStateChangedRemote:FireClient(player, false, "")
    end
end

local function triggerRandomStreamEvent(player: Player)
    if not isStreaming[player] or pendingEventByPlayer[player] ~= nil then
        return
    end

    local randomEvent = StreamEventsConfig[math.random(1, #StreamEventsConfig)]
    pendingEventByPlayer[player] = randomEvent

    streamPromptRemote:FireClient(player, {
        Id = randomEvent.Id,
        Title = randomEvent.Title,
        Situation = randomEvent.Situation,
        TimeoutSeconds = randomEvent.TimeoutSeconds,
        Choices = randomEvent.Choices,
    })

    -- Auto timeout after TimeoutSeconds + 1s
    task.delay(randomEvent.TimeoutSeconds + 1, function()
        if pendingEventByPlayer[player] == randomEvent then
            pendingEventByPlayer[player] = nil
        end
    end)
end

local function parsePlatformSelection(player: Player, platformKey: string): ({ string }, number, number)
    local rawList = {}
    for part in string.gmatch(platformKey, "[^+]+") do
        local trimmed = string.match(part, "^%s*(.-)%s*$")
        if trimmed and (trimmed == "YouTube" or trimmed == "Twitch" or trimmed == "TikTok") then
            if not table.find(rawList, trimmed) then
                table.insert(rawList, trimmed)
            end
        end
    end

    if #rawList == 0 then
        table.insert(rawList, "YouTube")
    end

    local hasSplitLicense = player:GetAttribute("Owned_MultiStreamLicense") == true

    -- Without Robux Split Pass: can ONLY stream to ONE platform!
    if not hasSplitLicense or #rawList == 1 then
        local singlePlat = rawList[1]
        local info = StreamConfig.Platforms[singlePlat] or StreamConfig.Platforms.YouTube
        return { singlePlat }, info.MoneyMultiplier, info.HypeMultiplier
    else
        -- With Robux Split Pass: stream to TWO platforms simultaneously!
        local selectedTwo = { rawList[1], rawList[2] }
        return selectedTwo, 1.85, 1.50
    end
end

local function startStream(player: Player, platformKey: string)
    if isStreaming[player] then return end

    local validPlatforms, moneyMult, hypeMult = parsePlatformSelection(player, platformKey)
    local displayPlatformStr = table.concat(validPlatforms, " + ")

    local categoryKey = (player:GetAttribute("StreamCategory") :: string?) or "Gaming"
    local catInfo = StreamConfig.Categories[categoryKey] or StreamConfig.Categories.Gaming
    local isPC = catInfo.RequiresPC

    if isPC then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if root then
            local dist = (root.Position - DESK_POSITION).Magnitude
            if dist > 24 then
                rebirthResultRemote:FireClient(player, "PcRequired", "⚠️ You must be at your Computer Desk for Gaming or Just Chatting! (Sit at chair or switch to 📱 IRL to stream anywhere!)")
                return
            end
        end
        unequipPhone(player)
        updateMonitorDisplay(true, categoryKey, displayPlatformStr)
        player:SetAttribute("IsPCStream", true)
        player:SetAttribute("IsPhoneStream", false)
    else
        equipPhone(player)
        updateMonitorDisplay(false)
        player:SetAttribute("IsPCStream", false)
        player:SetAttribute("IsPhoneStream", true)
    end

    isStreaming[player] = true
    activePlatforms[player] = displayPlatformStr
    streamStateChangedRemote:FireClient(player, true, displayPlatformStr)

    player:SetAttribute("ActiveStreamPlatforms", displayPlatformStr)
    player:SetAttribute("IsStreamingYouTube", table.find(validPlatforms, "YouTube") ~= nil)
    player:SetAttribute("IsStreamingTwitch", table.find(validPlatforms, "Twitch") ~= nil)
    player:SetAttribute("IsStreamingTikTok", table.find(validPlatforms, "TikTok") ~= nil)

    if player.Character then
        updateOverhead(player.Character, player)
    end

    -- Серверний цикл нарахування нагород та запуск подій
    local streamThread = task.spawn(function()
        local secondsSinceLastEvent = 0
        local nextEventThreshold = math.random(10, 14)
        local elapsedSeconds = 0

        while isStreaming[player] and player.Parent ~= nil do
            task.wait(StreamConfig.IncomeIntervalSeconds)

            if not isStreaming[player] or player.Parent == nil then break end
            elapsedSeconds += 1

            -- 1. Симуляція виживання: витрата Енергії (Energy Drain)
            local infiniteExp = (player:GetAttribute("InfiniteEnergyExpiry") :: number?) or 0
            local hasInfiniteEnergy = infiniteExp > os.time()

            local maxEnergy = (player:GetAttribute("MaxEnergy") :: number?) or StreamConfig.MaxEnergy
            local currentEnergy = (player:GetAttribute("Energy") :: number?) or maxEnergy

            if hasInfiniteEnergy then
                currentEnergy = maxEnergy
                player:SetAttribute("Energy", maxEnergy)
            elseif elapsedSeconds % StreamConfig.EnergyDrainSeconds == 0 then
                local drain = StreamConfig.EnergyDrainPerSecond or 2
                currentEnergy = math.max(0, currentEnergy - drain)
                player:SetAttribute("Energy", currentEnergy)

                -- Якщо енергія впала до 0 — стрімер втрачає свідомість від втоми
                if currentEnergy <= 0 then
                    stopStream(player)
                    break
                end
            end

            -- Перевірка відстані для ПК-стрімів (Gaming / Just Chatting)
            if isPC then
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
                if root then
                    local dist = (root.Position - DESK_POSITION).Magnitude
                    if dist > 30 then
                        stopStream(player)
                        rebirthResultRemote:FireClient(player, "PcLeft", "⚠️ You stepped away from your PC Battlestation! Stream ended.")
                        break
                    end
                end
            end

            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local moneyObj = leaderstats:FindFirstChild("Money") :: IntValue?
                local hypeObj = leaderstats:FindFirstChild("Hype") :: IntValue?

                if moneyObj and hypeObj then
                    local gamesCount = (player:GetAttribute("GamesOwnedCount") :: number?) or 0
                    local gearCount = (player:GetAttribute("GearOwnedCount") :: number?) or 0

                    -- Динамічний старт: дохід та підписники йдуть стабільно та захоплююче!
                    local baseMoney = 0
                    local baseHype = 0

                    if math.random() < StreamConfig.BaseDonationChance then
                        baseMoney = math.random(2, 4)
                    end
                    if math.random() < StreamConfig.BaseSubChance then
                        baseHype = math.random(3, 7)
                    end

                    -- Бонуси від купленого заліза та ігор (CyberByte Tech Store)
                    local equipMoneyBonus = (player:GetAttribute("StreamMoneyBonus") :: number?) or 0
                    local equipHypeBonus = (player:GetAttribute("StreamHypeBonus") :: number?) or 0
                    local audienceBonus = math.floor(hypeObj.Value * 0.003) -- Дуже плавний приріст від постійної аудиторії (0.3%)

                    local totalMoney = baseMoney + equipMoneyBonus + audienceBonus
                    local totalHype = baseHype + equipHypeBonus

                    -- Штраф втоми (якщо енергія < 25% — дохід падає на 50%)
                    if currentEnergy < 25 and not hasInfiniteEnergy then
                        totalMoney = math.floor(totalMoney * 0.5)
                        totalHype = math.floor(totalHype * 0.5)
                    end

                    -- Множники платформи (1 платформа або Split 2-Platforms з Robux)
                    totalMoney = math.floor(totalMoney * moneyMult)
                    totalHype = math.floor(totalHype * hypeMult)

                    -- Множники категорії (IRL, Gaming, Just Chatting)
                    totalMoney = math.floor(totalMoney * catInfo.MoneyMultiplier)
                    totalHype = math.floor(totalHype * catInfo.HypeMultiplier)

                    -- PC Gaming: синергія з купленими іграми в Steam (+20% грошей та +15% сабів за кожну гру)
                    if categoryKey == "Gaming" and gamesCount > 0 then
                        totalMoney = math.floor(totalMoney * (1.0 + (gamesCount * 0.20)))
                        totalHype = math.floor(totalHype * (1.0 + (gamesCount * 0.15)))
                    end

                    -- VIP Pass (+50% грошей, +25% сабів)
                    if player:GetAttribute("IsVIP") == true then
                        totalMoney = math.floor(totalMoney * 1.5)
                        totalHype = math.floor(totalHype * 1.25)
                    end

                    -- 2X Viral Stream Boost (Robux DevProduct)
                    local viralBoostExp = (player:GetAttribute("ViralBoostExpiry") :: number?) or 0
                    if viralBoostExp > os.time() then
                        totalHype = math.floor(totalHype * 2.0)
                    end

                    -- Rebirth Multiplier (+50% Cash & Subs per Rebirth level!)
                    local rebirths = (player:GetAttribute("Rebirths") :: number?) or 0
                    if rebirths > 0 then
                        local rebirthMult = 1.0 + (rebirths * StreamConfig.Rebirth.MultiplierPerRebirth)
                        totalMoney = math.floor(totalMoney * rebirthMult)
                        totalHype = math.floor(totalHype * rebirthMult)
                    end

                    -- Щогодинний буст 1.5х
                    local eventFolder = ReplicatedStorage:FindFirstChild("EventState")
                    local isBoostActive = eventFolder and eventFolder:FindFirstChild("IsBoostActive") and (eventFolder.IsBoostActive :: BoolValue).Value
                    if isBoostActive then
                        totalMoney = math.floor(totalMoney * StreamConfig.EventMoneyMultiplier)
                    end

                    moneyObj.Value += totalMoney
                    hypeObj.Value += totalHype

                    -- Оновлення рангу стрімера для HUD
                    local rankTitle = "Potato Setup"
                    if gearCount >= 3 and gamesCount >= 2 then
                        rankTitle = "Pro Battlestation"
                    elseif gearCount >= 2 or gamesCount >= 2 then
                        rankTitle = "Rising Streamer"
                    elseif gearCount >= 1 or gamesCount >= 1 then
                        rankTitle = "Budget Creator"
                    end
                    player:SetAttribute("StreamRankTitle", rankTitle)

                    if player.Character then
                        updateOverhead(player.Character, player)
                    end
                end
            end

            -- Таймер випадкових подій під час стріму
            secondsSinceLastEvent += 1
            if secondsSinceLastEvent >= nextEventThreshold then
                secondsSinceLastEvent = 0
                nextEventThreshold = math.random(30, 45)
                task.spawn(triggerRandomStreamEvent, player)
            end
        end
    end)

    activeStreamThreads[player] = streamThread
end

-- Обработка відповіді на динамічну подію
submitChoiceRemote.OnServerEvent:Connect(function(player: Player, eventId: any, choiceId: any)
    local activeEvent = pendingEventByPlayer[player]
    if not activeEvent or activeEvent.Id ~= eventId then return end
    pendingEventByPlayer[player] = nil

    local chosenOption = nil
    for _, ch in activeEvent.Choices do
        if ch.Id == choiceId then
            chosenOption = ch
            break
        end
    end
    if not chosenOption then return end

    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end
    local hypeObj = leaderstats:FindFirstChild("Hype") :: IntValue?
    local moneyObj = leaderstats:FindFirstChild("Money") :: IntValue?
    if not hypeObj or not moneyObj then return end

    local isSuccess = math.random() <= chosenOption.SuccessChance
    local currentHype = hypeObj.Value

    local hypeDelta = 0
    local moneyDelta = 0
    local message = ""

    if isSuccess then
        -- Точна пропорційна формула успіху від кількості підписників:
        -- При 1000 сабів: 1000 * 0.10 = +100
        -- При 50 сабів: 50 * 0.10 = +5
        -- Для початківця: мінімум +5
        hypeDelta = math.max(5, math.round(currentHype * chosenOption.SuccessHypeMultiplier))
        -- 2X Viral Boost multiplier
        if (player:GetAttribute("ViralBoostExpiry") or 0) > os.time() then
            hypeDelta = math.floor(hypeDelta * 2.0)
        end
        -- VIP Multipliers (+25% subs, +50% cash)
        if player:GetAttribute("IsVIP") == true then
            hypeDelta = math.floor(hypeDelta * 1.25)
            moneyDelta = math.floor(chosenOption.MoneyReward * 1.5)
        else
            moneyDelta = chosenOption.MoneyReward
        end
        message = chosenOption.SuccessMessage
    else
        -- Точна формула невдачі:
        -- При 1000 сабів: 1000 * -0.05 = -50
        -- При 50 сабів: 50 * 0.05 = 2.5 -> math.round = 3 (-3 саби)
        -- Для початківця: мінімум -1 або -2
        local rawLoss = math.round(currentHype * math.abs(chosenOption.FailHypeMultiplier))
        hypeDelta = -math.max(1, rawLoss)
        moneyDelta = 0
        message = chosenOption.FailMessage
    end

    -- Apply results
    hypeObj.Value = math.max(0, hypeObj.Value + hypeDelta)
    moneyObj.Value = math.max(0, moneyObj.Value + moneyDelta)

    if player.Character then
        updateOverhead(player.Character, player)
    end

    -- Send result to client
    choiceResultRemote:FireClient(player, {
        Success = isSuccess,
        Message = message,
        HypeDelta = hypeDelta,
        MoneyDelta = moneyDelta,
    })
end)

-- Обробка запиту Start/Stop від клієнта
toggleStreamRemote.OnServerEvent:Connect(function(player: Player, requestedPlatform: any)
    local now = os.clock()
    local lastTime = lastToggleTimestamp[player] or 0
    if (now - lastTime) < TOGGLE_COOLDOWN then
        return
    end
    lastToggleTimestamp[player] = now

    if isStreaming[player] then
        stopStream(player)
    else
        -- Перевіряємо, чи гравець закріпив платформу до ребірсу
        local lockedPlat = player:GetAttribute("LockedPlatform") :: string?
        if not lockedPlat or lockedPlat == "" then
            -- Якщо платформа ще не вибрана — відкриваємо вікно вибору платформи
            promptPlatformSelectRemote:FireClient(player, false)
            return
        end

        startStream(player, lockedPlat)
    end
end)

-- 7. Закріплення платформи до ребірсу (Client -> Server)
lockPlatformRemote.OnServerEvent:Connect(function(player: Player, requestedPlatform: any)
    if typeof(requestedPlatform) ~= "string" then return end

    -- Якщо платформа вже зафіксована для поточного ребірсу — блокуємо зміну
    local existingLock = player:GetAttribute("LockedPlatform")
    if existingLock and existingLock ~= "" then
        rebirthResultRemote:FireClient(player, "PlatformAlreadyLocked", existingLock)
        return
    end

    local validPlatforms, _, _ = parsePlatformSelection(player, requestedPlatform)
    local lockedKey = table.concat(validPlatforms, "+")
    local displayNames = table.concat(validPlatforms, " + ")

    player:SetAttribute("LockedPlatform", lockedKey)
    player:SetAttribute("ActiveStreamPlatforms", displayNames)
    rebirthResultRemote:FireClient(player, "PlatformLocked", displayNames)
end)

-- 11. Вибір категорії стріму (Client -> Server)
setStreamCategoryRemote.OnServerEvent:Connect(function(player: Player, requestedCategory: any)
    if typeof(requestedCategory) == "string" and StreamConfig.Categories[requestedCategory] then
        player:SetAttribute("StreamCategory", requestedCategory)
    end
end)

-- 8. Виконання Ребірсу (Rebirth)
performRebirthRemote.OnServerEvent:Connect(function(player: Player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local hypeObj = leaderstats:FindFirstChild("Hype") :: IntValue?
    local moneyObj = leaderstats:FindFirstChild("Money") :: IntValue?
    local rebirthsObj = leaderstats:FindFirstChild("Rebirths") :: IntValue?
    if not hypeObj or not moneyObj then return end

    local currentRebirths = rebirthsObj and rebirthsObj.Value or ((player:GetAttribute("Rebirths") :: number?) or 0)
    local reqSubs, reqMoney = StreamConfig.GetRebirthRequirements(currentRebirths)

    if hypeObj.Value >= reqSubs and moneyObj.Value >= reqMoney then
        if isStreaming[player] then
            stopStream(player)
        end

        local newRebirths = currentRebirths + 1
        if rebirthsObj then
            rebirthsObj.Value = newRebirths
        end
        player:SetAttribute("Rebirths", newRebirths)

        -- Скидання параметрів поточної кар'єри
        hypeObj.Value = 0
        local starterBonus = newRebirths * StreamConfig.Rebirth.StarterCashBonusPerRebirth
        moneyObj.Value = StreamConfig.StarterMoney + starterBonus

        local maxEnergy = StreamConfig.MaxEnergy + (newRebirths * StreamConfig.Rebirth.MaxEnergyBonusPerRebirth)
        player:SetAttribute("MaxEnergy", maxEnergy)
        player:SetAttribute("Energy", maxEnergy)

        -- РОЗБЛОКУВАННЯ ПЛАТФОРМИ: гравець може вибрати нову платформу для нового життя!
        player:SetAttribute("LockedPlatform", nil)
        player:SetAttribute("ActiveStreamPlatforms", nil)

        if player.Character then
            updateOverhead(player.Character, player)
        end

        -- Сповіщаємо клієнта та відкриваємо вікно вибору нової платформи
        rebirthResultRemote:FireClient(player, "RebirthSuccess", newRebirths)
        promptPlatformSelectRemote:FireClient(player, true)
    else
        rebirthResultRemote:FireClient(player, "RebirthFailed", `Requires {reqSubs} Subs and ${reqMoney} Cash!`)
    end
end)

--------------------------------------------------------------------------------
-- Обробка назви каналу
--------------------------------------------------------------------------------
setChannelNameRemote.OnServerEvent:Connect(function(player: Player, requestedName: any)
    if typeof(requestedName) ~= "string" then return end
    local cleanedName = string.gsub(requestedName, "^%s*(.-)%s*$", "%1")

    if #cleanedName < StreamConfig.MinChannelNameLength or #cleanedName > StreamConfig.MaxChannelNameLength then
        return
    end

    local filteredName = cleanedName
    local success, result = pcall(function()
        local filterResult = TextService:FilterStringAsync(cleanedName, player.UserId)
        return filterResult:GetNonChatStringForBroadcastAsync()
    end)
    if success and result and #result > 0 then
        filteredName = result
    end

    player:SetAttribute("ChannelName", filteredName)
    if player.Character then
        updateOverhead(player.Character, player)
        if isStreaming[player] then
            equipPhone(player)
        end
    end
end)

local function onPlayerAdded(player: Player)
    if not player:GetAttribute("ChannelName") then
        player:SetAttribute("ChannelName", player.DisplayName .. " TV")
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if char.Parent ~= nil then
            updateOverhead(char, player)
            if isStreaming[player] then
                equipPhone(player)
            end
        end
    end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
    task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player: Player)
    unequipPhone(player)
    isStreaming[player] = nil
    activePlatforms[player] = nil
    lastToggleTimestamp[player] = nil
    activeStreamThreads[player] = nil
    pendingEventByPlayer[player] = nil
end)

--------------------------------------------------------------------------------
-- 7. Gaming Chair & Desk Setup with ProximityPrompt
--------------------------------------------------------------------------------
task.spawn(function()
    local cityWorld = workspace:WaitForChild("CityWorld", 10) :: Model?
    local chairSeat = (cityWorld and cityWorld:FindFirstChild("GamingChairSeat", true)) or workspace:FindFirstChild("GamingChairSeat", true) :: Seat?
    if not chairSeat then return end

    local sitPrompt = chairSeat:FindFirstChild("SitPrompt") :: ProximityPrompt?
    if not sitPrompt then
        sitPrompt = Instance.new("ProximityPrompt")
        sitPrompt.Name = "SitPrompt"
        sitPrompt.ObjectText = "Streaming Battlestation"
        sitPrompt.ActionText = "Sit & Stream (E)"
        sitPrompt.HoldDuration = 0
        sitPrompt.MaxActivationDistance = 10
        sitPrompt.KeyboardKeyCode = Enum.KeyCode.E
        sitPrompt.RequiresLineOfSight = false
        sitPrompt.Parent = chairSeat
    end

    sitPrompt.Triggered:Connect(function(player: Player)
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and chairSeat.Occupant == nil then
                chairSeat:Sit(humanoid)
            end
        end
    end)

    chairSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
        sitPrompt.Enabled = (chairSeat.Occupant == nil)
    end)
end)

--------------------------------------------------------------------------------
-- Пасивне відновлення сил під час відпочинку (поза стрімом)
--------------------------------------------------------------------------------
task.spawn(function()
    while true do
        task.wait(StreamConfig.EnergyRestRecoverySeconds or 2)
        for _, player in Players:GetPlayers() do
            if not isStreaming[player] and player.Parent ~= nil then
                local maxEnergy = (player:GetAttribute("MaxEnergy") :: number?) or StreamConfig.MaxEnergy
                local currentEnergy = (player:GetAttribute("Energy") :: number?) or maxEnergy
                if currentEnergy < maxEnergy then
                    local restored = math.min(maxEnergy, currentEnergy + 3)
                    player:SetAttribute("Energy", restored)
                end
            end
        end
    end
end)

]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_ShopManager">
			<Properties>
				<string name="Name">ShopManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShopConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShopConfig") :: ModuleScript)

-- Ensure Remotes
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local buyItemRemote = remotesFolder:FindFirstChild("BuyShopItem") :: RemoteEvent?
if not buyItemRemote then
    buyItemRemote = Instance.new("RemoteEvent")
    buyItemRemote.Name = "BuyShopItem"
    buyItemRemote.Parent = remotesFolder
end

local shopResultRemote = remotesFolder:FindFirstChild("ShopItemPurchased") :: RemoteEvent?
if not shopResultRemote then
    shopResultRemote = Instance.new("RemoteEvent")
    shopResultRemote.Name = "ShopItemPurchased"
    shopResultRemote.Parent = remotesFolder
end

local promptRobuxRemote = remotesFolder:FindFirstChild("PromptRobuxPurchase") :: RemoteEvent?
if not promptRobuxRemote then
    promptRobuxRemote = Instance.new("RemoteEvent")
    promptRobuxRemote.Name = "PromptRobuxPurchase"
    promptRobuxRemote.Parent = remotesFolder
end

local broadcastSuperChatRemote = remotesFolder:FindFirstChild("BroadcastSuperChat") :: RemoteEvent?
if not broadcastSuperChatRemote then
    broadcastSuperChatRemote = Instance.new("RemoteEvent")
    broadcastSuperChatRemote.Name = "BroadcastSuperChat"
    broadcastSuperChatRemote.Parent = remotesFolder
end

local MarketplaceService = game:GetService("MarketplaceService")
-- Replace with your real Gamepass IDs from Roblox Creator Hub when publishing
local MULTISTREAM_GAMEPASS_ID = 0 -- Set to real Gamepass ID on publish
local VIP_GAMEPASS_ID = 0         -- Set to real VIP Gamepass ID on publish


local function recalculateBonuses(player: Player)
    local totalMoneyBonus = 0
    local totalHypeBonus = 0
    local gamesOwned = 0
    local gearOwned = 0

    for itemId, item in ShopConfig do
        if player:GetAttribute("Owned_" .. itemId) == true then
            totalMoneyBonus += item.MoneyBonusPerTick
            totalHypeBonus += item.HypeBonusPerTick
            if item.Category == "Game" then
                gamesOwned += 1
            elseif item.Category == "Gear" then
                gearOwned += 1
            end
        end
    end

    player:SetAttribute("StreamMoneyBonus", totalMoneyBonus)
    player:SetAttribute("StreamHypeBonus", totalHypeBonus)
    player:SetAttribute("GamesOwnedCount", gamesOwned)
    player:SetAttribute("GearOwnedCount", gearOwned)
end

buyItemRemote.OnServerEvent:Connect(function(player: Player, itemId: any)
    if typeof(itemId) ~= "string" then return end

    if itemId == "MultiStreamLicense" then
        shopResultRemote:FireClient(player, itemId, false, "Multi-Stream Split is Robux-exclusive!")
        return
    end

    local item = ShopConfig[itemId]
    if not item then return end

    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local moneyVal = leaderstats:FindFirstChild("Money") :: IntValue?
    if not moneyVal then return end

    -- Check balance
    if moneyVal.Value < item.Price then
        shopResultRemote:FireClient(player, itemId, false, "Not enough money!")
        return
    end

    -- Handling Food Consumables
    if item.Category == "Food" then
        moneyVal.Value -= item.Price
        local currentEnergy = (player:GetAttribute("Energy") :: number?) or 100
        local newEnergy = math.min(100, currentEnergy + item.EnergyRestore)
        player:SetAttribute("Energy", newEnergy)
        shopResultRemote:FireClient(player, itemId, true, `Consumed {item.Name}! Energy +{item.EnergyRestore}%`)
        return
    end

    -- Handling Permanent Hardware / Games / License
    if player:GetAttribute("Owned_" .. itemId) == true then
        shopResultRemote:FireClient(player, itemId, false, "Already owned!")
        return
    end

    -- Process purchase
    moneyVal.Value -= item.Price
    player:SetAttribute("Owned_" .. itemId, true)
    recalculateBonuses(player)

    shopResultRemote:FireClient(player, itemId, true, `Successfully purchased {item.Name}!`)
end)

local function grantRobuxProduct(player: Player, productId: string)
    local leaderstats = player:FindFirstChild("leaderstats")
    local moneyVal = leaderstats and leaderstats:FindFirstChild("Money") :: IntValue?
    local hypeVal = leaderstats and leaderstats:FindFirstChild("Hype") :: IntValue?

    if productId == "Pass_VIP" then
        if player:GetAttribute("Owned_Pass_VIP") == true then
            shopResultRemote:FireClient(player, productId, false, "VIP Pass is already owned!")
            return
        end
        player:SetAttribute("Owned_Pass_VIP", true)
        player:SetAttribute("IsVIP", true)
        recalculateBonuses(player)
        shopResultRemote:FireClient(player, productId, true, "👑 VIP Status Activated! Permanent +50% Cash & +25% Subs!")
    elseif productId == "Boost_Viral2X" then
        local now = os.time()
        local currentExpiry = math.max(now, (player:GetAttribute("ViralBoostExpiry") :: number?) or 0)
        local newExpiry = currentExpiry + 15 * 60
        player:SetAttribute("ViralBoostExpiry", newExpiry)
        shopResultRemote:FireClient(player, productId, true, "🚀 2X Viral Stream Boost Activated for 15 minutes!")
    elseif productId == "Surge_Energy" then
        player:SetAttribute("Energy", 100)
        local now = os.time()
        local currentEnergyExp = math.max(now, (player:GetAttribute("InfiniteEnergyExpiry") :: number?) or 0)
        local newExpiry = currentEnergyExp + 5 * 60
        player:SetAttribute("InfiniteEnergyExpiry", newExpiry)
        shopResultRemote:FireClient(player, productId, true, "⚡ Energy Refilled to 100% & Infinite Stamina for 5 mins!")
    elseif productId == "Alert_SuperChat" then
        if moneyVal then moneyVal.Value += 200 end
        if hypeVal then hypeVal.Value += 500 end
        broadcastSuperChatRemote:FireAllClients(player.DisplayName, 500)
        shopResultRemote:FireClient(player, productId, true, "📣 Super-Chat Broadcast Sent to entire server! +$200 & +500 Subs!")
    elseif productId == "Cash_Pack_Small" then
        if moneyVal then moneyVal.Value += 300 end
        shopResultRemote:FireClient(player, productId, true, "💵 +$300 Cash Added to your balance!")
    elseif productId == "Cash_Pack_Medium" then
        if moneyVal then moneyVal.Value += 1500 end
        shopResultRemote:FireClient(player, productId, true, "💰 +$1,500 Cash Added to your balance!")
    elseif productId == "Cash_Pack_Large" then
        if moneyVal then moneyVal.Value += 5000 end
        shopResultRemote:FireClient(player, productId, true, "💎 +$5,000 Cash Added to your balance!")
    elseif productId == "MultiStreamLicense" then
        if player:GetAttribute("Owned_MultiStreamLicense") == true then
            shopResultRemote:FireClient(player, productId, false, "Multi-Stream is already owned!")
            return
        end
        player:SetAttribute("Owned_MultiStreamLicense", true)
        recalculateBonuses(player)
        shopResultRemote:FireClient(player, productId, true, "⭐ Multi-Stream Combo (YouTube + Twitch) unlocked!")
    end
end

promptRobuxRemote.OnServerEvent:Connect(function(player: Player, productId: any)
    if typeof(productId) ~= "string" then return end

    local robuxProducts = (ShopConfig :: any).RobuxProducts
    local prod = robuxProducts and robuxProducts[productId]
    if not prod then return end

    if prod.Type == "GamePass" then
        local passId = (productId == "Pass_VIP") and VIP_GAMEPASS_ID or MULTISTREAM_GAMEPASS_ID
        -- Only prompt Roblox CoreGui if a real valid Gamepass ID (> 1000) has been configured
        if passId and passId > 1000 and passId ~= 99999999 and passId ~= 88888888 then
            pcall(function()
                MarketplaceService:PromptGamePassPurchase(player, passId)
            end)
        else
            -- Dev / Studio testing: unlock directly without showing 'This item is not currently for sale'
            grantRobuxProduct(player, productId)
        end
    else
        -- Developer Product purchase
        local devProductId = (prod :: any).DevProductId
        if devProductId and devProductId > 1000 and devProductId ~= 12345678 then
            pcall(function()
                MarketplaceService:PromptProductPurchase(player, devProductId)
            end)
        else
            -- Dev / Studio testing: unlock directly
            grantRobuxProduct(player, productId)
        end
    end
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
    if purchased then
        if passId == MULTISTREAM_GAMEPASS_ID then
            grantRobuxProduct(player, "MultiStreamLicense")
        elseif passId == VIP_GAMEPASS_ID then
            grantRobuxProduct(player, "Pass_VIP")
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
    player:SetAttribute("StreamMoneyBonus", 0)
    player:SetAttribute("StreamHypeBonus", 0)
    player:SetAttribute("GamesOwnedCount", 0)
    player:SetAttribute("GearOwnedCount", 0)
    player:SetAttribute("Energy", 100)
    player:SetAttribute("ViralBoostExpiry", 0)
    player:SetAttribute("InfiniteEnergyExpiry", 0)
    player:SetAttribute("IsVIP", false)
end)


]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_EventManager">
			<Properties>
				<string name="Name">EventManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StreamConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("StreamConfig") :: ModuleScript)

-- Ensure EventState Folder in ReplicatedStorage
local eventStateFolder = ReplicatedStorage:FindFirstChild("EventState")
if not eventStateFolder then
    eventStateFolder = Instance.new("Folder")
    eventStateFolder.Name = "EventState"
    eventStateFolder.Parent = ReplicatedStorage
end

local isBoostActiveObj = eventStateFolder:FindFirstChild("IsBoostActive") :: BoolValue?
if not isBoostActiveObj then
    isBoostActiveObj = Instance.new("BoolValue")
    isBoostActiveObj.Name = "IsBoostActive"
    isBoostActiveObj.Value = false
    isBoostActiveObj.Parent = eventStateFolder
end

local remainingSecondsObj = eventStateFolder:FindFirstChild("RemainingSeconds") :: IntValue?
if not remainingSecondsObj then
    remainingSecondsObj = Instance.new("IntValue")
    remainingSecondsObj.Name = "RemainingSeconds"
    remainingSecondsObj.Value = 0
    remainingSecondsObj.Parent = eventStateFolder
end

-- Timing Configuration
local CYCLE_TIME = StreamConfig.EventCycleDurationSeconds or 3600 -- 1 Hour
local BOOST_TIME = StreamConfig.EventBoostDurationSeconds or 600   -- 10 Minutes
local WAIT_TIME = CYCLE_TIME - BOOST_TIME                         -- 50 Minutes

task.spawn(function()
    while true do
        -- 1. Cooldown / Wait phase (50 mins)
        isBoostActiveObj.Value = false
        for sec = WAIT_TIME, 1, -1 do
            remainingSecondsObj.Value = sec
            task.wait(1)
        end

        -- 2. Active Boost Phase (10 mins)
        isBoostActiveObj.Value = true
        for sec = BOOST_TIME, 1, -1 do
            remainingSecondsObj.Value = sec
            task.wait(1)
        end
    end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_LeaderboardManager">
			<Properties>
				<string name="Name">LeaderboardManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

local surfaceGui: SurfaceGui? = nil
local container: ScrollingFrame? = nil

-- Функція гарантованого створення / налаштування SurfaceGui на табло
local function ensureSurfaceGui(): boolean
    if surfaceGui and container and surfaceGui.Parent then
        return true
    end

    local streamerCorner = workspace:WaitForChild("StreamerCorner", 10)
    if not streamerCorner then return false end

    local board = streamerCorner:WaitForChild("LeaderboardBoard", 10)
    if not board then return false end

    local display = board:WaitForChild("Display", 10) :: BasePart?
    if not display then return false end

    -- Очищаємо старі SurfaceGui якщо були з неправильною стороною
    for _, child in display:GetChildren() do
        if child:IsA("SurfaceGui") then
            child:Destroy()
        end
    end

    -- Створюємо новий ідеальний SurfaceGui на лицьовій стороні (Front = 5)
    local sg = Instance.new("SurfaceGui")
    sg.Name = "LeaderboardGui"
    sg.Face = Enum.NormalId.Front -- Лицьова сторона, повернена до гравця!
    sg.CanvasSize = Vector2.new(800, 560)
    sg.LightInfluence = 0 -- Яскраве світіння екрана навіть уночі!
    sg.AlwaysOnTop = false
    sg.Parent = display

    -- Заголовок табло
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 70)
    header.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
    header.BorderSizePixel = 0
    header.Parent = sg

    local headerStroke = Instance.new("UIStroke")
    headerStroke.Color = Color3.fromRGB(255, 215, 0)
    headerStroke.Thickness = 2
    headerStroke.Parent = header

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0.6, 0)
    title.Position = UDim2.new(0, 0, 0.05, 0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 26
    title.TextColor3 = Color3.fromRGB(255, 215, 0)
    title.Text = "🏆 TOP STREAMERS | WALL OF FAME"
    title.Parent = header

    local subtitle = Instance.new("TextLabel")
    subtitle.Size = UDim2.new(1, 0, 0.35, 0)
    subtitle.Position = UDim2.new(0, 0, 0.6, 0)
    subtitle.BackgroundTransparency = 1
    subtitle.Font = Enum.Font.GothamMedium
    subtitle.TextSize = 14
    subtitle.TextColor3 = Color3.fromRGB(180, 190, 210)
    subtitle.Text = "⭐ Top Stream Channels Ranked by Subscribers"
    subtitle.Parent = header

    -- Контейнер для списку стрімерів
    local sc = Instance.new("ScrollingFrame")
    sc.Name = "ScrollContainer"
    sc.Size = UDim2.new(1, -20, 1, -85)
    sc.Position = UDim2.new(0, 10, 0, 80)
    sc.BackgroundTransparency = 1
    sc.BorderSizePixel = 0
    sc.ScrollBarThickness = 6
    sc.ScrollBarImageColor3 = Color3.fromRGB(255, 215, 0)
    sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
    sc.Parent = sg

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = sc

    surfaceGui = sg
    container = sc
    return true
end

-- Головна функція оновлення табло
local function updateLeaderboard()
    if not ensureSurfaceGui() or not container then
        return
    end

    -- Збираємо всіх гравців
    local playerList: { { Player: Player, Hype: number, Channel: string } } = {}
    for _, player in Players:GetPlayers() do
        local leaderstats = player:FindFirstChild("leaderstats")
        local hypeVal = leaderstats and leaderstats:FindFirstChild("Hype") :: IntValue?
        local hype = hypeVal and hypeVal.Value or 0
        local channel = player:GetAttribute("ChannelName") or (player.DisplayName .. " TV")

        table.insert(playerList, {
            Player = player,
            Hype = hype,
            Channel = tostring(channel),
        })
    end

    -- Сортуємо за Hype спаданням
    table.sort(playerList, function(a, b)
        return a.Hype > b.Hype
    end)

    -- Очищаємо старі рядки
    for _, child in container:GetChildren() do
        if child:IsA("Frame") and child.Name:sub(1, 4) == "Row_" then
            child:Destroy()
        end
    end

    local medals = { "🥇", "🥈", "🥉" }

    -- Створюємо рядки (до 10 гравців)
    for rank = 1, math.min(#playerList, 10) do
        local data = playerList[rank]
        local row = Instance.new("Frame")
        row.Name = `Row_{rank}`
        row.LayoutOrder = rank
        row.Size = UDim2.new(1, -8, 0, 56)
        row.BackgroundColor3 = if rank == 1 then Color3.fromRGB(48, 42, 22)
            elseif rank == 2 then Color3.fromRGB(38, 40, 48)
            elseif rank == 3 then Color3.fromRGB(44, 34, 26)
            else Color3.fromRGB(24, 27, 36)
        row.BorderSizePixel = 0
        row.Parent = container

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = row

        local stroke = Instance.new("UIStroke")
        stroke.Color = if rank == 1 then Color3.fromRGB(255, 215, 0)
            elseif rank == 2 then Color3.fromRGB(200, 205, 215)
            elseif rank == 3 then Color3.fromRGB(215, 135, 60)
            else Color3.fromRGB(60, 65, 80)
        stroke.Thickness = if rank <= 3 then 2 else 1
        stroke.Parent = row

        -- Номер / Медаль
        local rankLabel = Instance.new("TextLabel")
        rankLabel.Size = UDim2.new(0, 55, 1, 0)
        rankLabel.BackgroundTransparency = 1
        rankLabel.Font = Enum.Font.GothamBold
        rankLabel.TextSize = 24
        rankLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        rankLabel.Text = if rank <= 3 then medals[rank] else `#{rank}`
        rankLabel.Parent = row

        -- Аватарка гравця
        local avatarImg = Instance.new("ImageLabel")
        avatarImg.Size = UDim2.new(0, 44, 0, 44)
        avatarImg.Position = UDim2.new(0, 60, 0.5, -22)
        avatarImg.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
        avatarImg.Image = `rbxthumb://type=AvatarHeadShot&id={data.Player.UserId}&w=100&h=100`
        avatarImg.Parent = row

        local avatarCorner = Instance.new("UICorner")
        avatarCorner.CornerRadius = UDim.new(1, 0)
        avatarCorner.Parent = avatarImg

        -- НАЗВА КАНАЛУ (Великий золотистий / білий акцент)
        local channelLabel = Instance.new("TextLabel")
        channelLabel.Size = UDim2.new(1, -290, 0, 28)
        channelLabel.Position = UDim2.new(0, 115, 0, 4)
        channelLabel.BackgroundTransparency = 1
        channelLabel.Font = Enum.Font.GothamBold
        channelLabel.TextSize = 18
        channelLabel.TextColor3 = if rank == 1 then Color3.fromRGB(255, 220, 80) else Color3.fromRGB(255, 255, 255)
        channelLabel.TextXAlignment = Enum.TextXAlignment.Left
        channelLabel.Text = `📺 {data.Channel}`
        channelLabel.TextTruncate = Enum.TextTruncate.AtEnd
        channelLabel.Parent = row

        -- Streamer username
        local authorLabel = Instance.new("TextLabel")
        authorLabel.Size = UDim2.new(1, -290, 0, 20)
        authorLabel.Position = UDim2.new(0, 115, 0, 30)
        authorLabel.BackgroundTransparency = 1
        authorLabel.Font = Enum.Font.Gotham
        authorLabel.TextSize = 13
        authorLabel.TextColor3 = Color3.fromRGB(160, 165, 180)
        authorLabel.TextXAlignment = Enum.TextXAlignment.Left
        authorLabel.Text = `Streamer: @{data.Player.DisplayName}`
        authorLabel.Parent = row

        -- Кількість підписників (Hype)
        local hypeLabel = Instance.new("TextLabel")
        hypeLabel.Size = UDim2.new(0, 160, 1, 0)
        hypeLabel.Position = UDim2.new(1, -170, 0, 0)
        hypeLabel.BackgroundTransparency = 1
        hypeLabel.Font = Enum.Font.GothamBold
        hypeLabel.TextSize = 18
        hypeLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        hypeLabel.TextXAlignment = Enum.TextXAlignment.Right
        hypeLabel.Text = `⭐ {data.Hype} Subs`
        hypeLabel.Parent = row
    end
end

-- Підключення слухачів для МИТТЄВОГО оновлення при зміні назви каналу чи хайпу
local function bindPlayer(player: Player)
    -- Оновлення при зміні атрибуту ChannelName
    player:GetAttributeChangedSignal("ChannelName"):Connect(function()
        updateLeaderboard()
    end)

    -- Оновлення при зміні Hype
    local leaderstats = player:WaitForChild("leaderstats", 10)
    if leaderstats then
        local hypeObj = leaderstats:WaitForChild("Hype", 10)
        if hypeObj then
            hypeObj.Changed:Connect(function()
                updateLeaderboard()
            end)
        end
    end

    updateLeaderboard()
end

Players.PlayerAdded:Connect(bindPlayer)
for _, p in Players:GetPlayers() do
    task.spawn(bindPlayer, p)
end

Players.PlayerRemoving:Connect(function()
    task.wait(0.2)
    updateLeaderboard()
end)

-- Регулярне фонове оновлення
task.spawn(function()
    task.wait(2)
    updateLeaderboard()
    while true do
        task.wait(3)
        pcall(updateLeaderboard)
    end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_VehicleManager">
			<Properties>
				<string name="Name">VehicleManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Create FlipCar remote if not present
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local flipCarRemote = remotesFolder:FindFirstChild("FlipCar") :: RemoteEvent?
if not flipCarRemote then
    flipCarRemote = Instance.new("RemoteEvent")
    flipCarRemote.Name = "FlipCar"
    flipCarRemote.Parent = remotesFolder
end

local function setupCar()
    local car = workspace:WaitForChild("CityWorld", 10) and workspace.CityWorld:WaitForChild("StarterCar", 10) :: Model?
    if not car then
        car = workspace:WaitForChild("StarterCar", 5) :: Model?
    end
    if not car then return end

    local chassis = car:WaitForChild("CarChassis", 5) :: BasePart?
    local seat = car:WaitForChild("VehicleSeat", 5) :: VehicleSeat?
    local passSeat = car:FindFirstChild("PassengerSeat") :: Seat?
    if not chassis or not seat then return end

    car.PrimaryPart = chassis

    -- Автоматично зварюємо всі деталі машини разом (WeldConstraint), щоб вона не розвалювалася!
    for _, part in car:GetDescendants() do
        if part:IsA("BasePart") and part ~= chassis then
            part.Anchored = false
            -- Тільки колеса мають колізію з землею. Кузов, дах і вікна CanCollide = false, щоб гравець не застрягав!
            part.CanCollide = (part.Name:find("Wheel") ~= nil)
            part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0.5, 100, 100)

            -- Створюємо WeldConstraint до шасі
            local weld = part:FindFirstChild("CarWeld") :: WeldConstraint?
            if not weld then
                weld = Instance.new("WeldConstraint")
                weld.Name = "CarWeld"
                weld.Part0 = chassis
                weld.Part1 = part
                weld.Parent = part
            end
        end
    end

    chassis.Anchored = false
    chassis.CanCollide = true
    chassis.CustomPhysicalProperties = PhysicalProperties.new(1.8, 0.9, 0.5, 100, 100)

    -- 3D Floating Badge над авто
    local existingBadge = chassis:FindFirstChild("CarBadge") :: BillboardGui?
    if not existingBadge then
        existingBadge = Instance.new("BillboardGui")
        existingBadge.Name = "CarBadge"
        existingBadge.Size = UDim2.new(0, 160, 0, 42)
        existingBadge.StudsOffset = Vector3.new(0, 4.8, 0)
        existingBadge.AlwaysOnTop = true
        existingBadge.MaxDistance = 90
        existingBadge.Parent = chassis

        local badgeFrame = Instance.new("Frame")
        badgeFrame.Size = UDim2.new(1, 0, 1, 0)
        badgeFrame.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
        badgeFrame.BackgroundTransparency = 0.2
        badgeFrame.BorderSizePixel = 0
        badgeFrame.Parent = existingBadge

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 10)
        bCorner.Parent = badgeFrame

        local bStroke = Instance.new("UIStroke")
        bStroke.Color = Color3.fromRGB(231, 76, 60)
        bStroke.Thickness = 2
        bStroke.Parent = badgeFrame

        local bLabel = Instance.new("TextLabel")
        bLabel.Size = UDim2.new(1, 0, 1, 0)
        bLabel.BackgroundTransparency = 1
        bLabel.Font = Enum.Font.GothamBold
        bLabel.TextSize = 14
        bLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        bLabel.Text = "🚗 Starter Sedan [E]"
        bLabel.Parent = badgeFrame
    end

    -- Надійний ProximityPrompt для посадки за кермо (E)
    local drivePrompt = chassis:FindFirstChild("DrivePrompt") :: ProximityPrompt?
    if not drivePrompt then
        drivePrompt = Instance.new("ProximityPrompt")
        drivePrompt.Name = "DrivePrompt"
        drivePrompt.ObjectText = "Starter Sedan"
        drivePrompt.ActionText = "Drive Car (E)"
        drivePrompt.HoldDuration = 0
        drivePrompt.MaxActivationDistance = 14
        drivePrompt.KeyboardKeyCode = Enum.KeyCode.E
        drivePrompt.RequiresLineOfSight = false
        drivePrompt.Parent = chassis
    end

    drivePrompt.Triggered:Connect(function(player: Player)
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and seat.Occupant == nil then
                seat:Sit(humanoid)
            end
        end
    end)

    seat:GetPropertyChangedSignal("Occupant"):Connect(function()
        if drivePrompt then
            drivePrompt.Enabled = (seat.Occupant == nil)
        end
        if existingBadge then
            existingBadge.Enabled = (seat.Occupant == nil)
        end
    end)

    -- Пасажирське сидіння
    if passSeat then
        local passPrompt = Instance.new("ProximityPrompt")
        passPrompt.Name = "PassengerPrompt"
        passPrompt.ObjectText = "Passenger Seat"
        passPrompt.ActionText = "Sit as Passenger"
        passPrompt.HoldDuration = 0
        passPrompt.MaxActivationDistance = 12
        passPrompt.KeyboardKeyCode = Enum.KeyCode.G
        passPrompt.RequiresLineOfSight = false
        passPrompt.Parent = passSeat

        passPrompt.Triggered:Connect(function(player: Player)
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid and passSeat.Occupant == nil then
                    passSeat:Sit(humanoid)
                end
            end
        end)

        passSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
            passPrompt.Enabled = (passSeat.Occupant == nil)
        end)
    end

    -- Надійний аркадний привід (BodyVelocity + BodyAngularVelocity)
    local bv = chassis:FindFirstChild("CarVelocity") :: BodyVelocity?
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "CarVelocity"
        bv.MaxForce = Vector3.new(0, 0, 0)
        bv.Velocity = Vector3.zero
        bv.Parent = chassis
    end

    local bav = chassis:FindFirstChild("CarAngularVelocity") :: BodyAngularVelocity?
    if not bav then
        bav = Instance.new("BodyAngularVelocity")
        bav.Name = "CarAngularVelocity"
        bav.MaxTorque = Vector3.new(0, 0, 0)
        bav.AngularVelocity = Vector3.zero
        bav.Parent = chassis
    end

    -- Стабілізатор горизонтального положення (запобігає перевертанню)
    local bg = chassis:FindFirstChild("CarGyro") :: BodyGyro?
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "CarGyro"
        bg.MaxTorque = Vector3.new(1e5, 0, 1e5)
        bg.P = 3000
        bg.Parent = chassis
    end

    local CAR_SPEED = 52
    local TURN_SPEED = 2.4
    local spawnPosition = Vector3.new(14, 2.5, -42)

    -- Обробка перевертання авто на клавішу F або при застряганні
    local function flipCar()
        local currentPos = chassis.Position
        local look = chassis.CFrame.LookVector
        chassis.CFrame = CFrame.lookAt(currentPos + Vector3.new(0, 3.5, 0), currentPos + Vector3.new(look.X, 0, look.Z))
        chassis.AssemblyLinearVelocity = Vector3.zero
        chassis.AssemblyAngularVelocity = Vector3.zero
    end

    flipCarRemote.OnServerEvent:Connect(function(player: Player)
        local character = player.Character
        if character and seat and seat.Occupant == character:FindFirstChildOfClass("Humanoid") then
            flipCar()
        end
    end)

    -- Цикл керування рухом автомобіля
    RunService.Heartbeat:Connect(function()
        if not seat or not chassis or not bv or not bav or not bg then return end

        local driver = seat.Occupant
        if driver then
            -- Гравець за кермом: передаємо команди W/S та A/D
            local throttle = seat.ThrottleFloat
            local steer = seat.SteerFloat

            -- Рух вперед/назад
            bv.MaxForce = Vector3.new(3e5, 0, 3e5)
            bv.Velocity = chassis.CFrame.LookVector * (throttle * CAR_SPEED)

            -- Поворот вліво/вправо
            bav.MaxTorque = Vector3.new(0, 3e5, 0)
            bav.AngularVelocity = Vector3.new(0, -steer * TURN_SPEED, 0)

            -- Стабілізація орієнтації
            bg.CFrame = CFrame.new(chassis.Position, chassis.Position + chassis.CFrame.LookVector)

            -- Увімкнення фар
            for _, descendant in car:GetDescendants() do
                if descendant:IsA("SpotLight") then
                    descendant.Enabled = true
                end
            end
        else
            -- Машина пуста: стоїть на ручнику
            bv.MaxForce = Vector3.new(3e5, 0, 3e5)
            bv.Velocity = Vector3.zero
            bav.MaxTorque = Vector3.new(0, 3e5, 0)
            bav.AngularVelocity = Vector3.zero

            -- Вимкнення фар
            for _, descendant in car:GetDescendants() do
                if descendant:IsA("SpotLight") then
                    descendant.Enabled = false
                end
            end
        end

        -- Автоматичне повернення машини, якщо вона впала нижче карти
        if chassis.Position.Y < -20 then
            chassis.CFrame = CFrame.new(spawnPosition)
            chassis.AssemblyLinearVelocity = Vector3.zero
            chassis.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

task.spawn(setupCar)
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX_StarterPlayer">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX_StarterPlayerScripts">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX_StreamGui">
				<Properties>
					<string name="Name">StreamGui</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StreamConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("StreamConfig") :: ModuleScript)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local performRebirthRemote = remotesFolder:WaitForChild("PerformRebirth") :: RemoteEvent
local rebirthResultRemote = remotesFolder:WaitForChild("RebirthResult") :: RemoteEvent
local setStreamCategoryRemote = remotesFolder:WaitForChild("SetStreamCategory") :: RemoteEvent

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StreamGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

--------------------------------------------------------------------------------
-- 0. Hourly Boost Event Banner (Top-Center HUD)
--------------------------------------------------------------------------------
local eventBanner = Instance.new("Frame")
eventBanner.Name = "EventBanner"
eventBanner.Size = UDim2.new(0, 310, 0, 36)
eventBanner.Position = UDim2.new(0.5, -155, 0.02, 0)
eventBanner.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
eventBanner.BackgroundTransparency = 0.25
eventBanner.BorderSizePixel = 0
eventBanner.Parent = screenGui

local bannerCorner = Instance.new("UICorner")
bannerCorner.CornerRadius = UDim.new(0, 18)
bannerCorner.Parent = eventBanner

local bannerStroke = Instance.new("UIStroke")
bannerStroke.Name = "BannerStroke"
bannerStroke.Color = Color3.fromRGB(52, 152, 219)
bannerStroke.Thickness = 1.5
bannerStroke.Parent = eventBanner

local bannerText = Instance.new("TextLabel")
bannerText.Name = "BannerText"
bannerText.Size = UDim2.new(1, 0, 1, 0)
bannerText.BackgroundTransparency = 1
bannerText.Font = Enum.Font.GothamBold
bannerText.TextSize = 13
bannerText.TextColor3 = Color3.fromRGB(240, 245, 255)
bannerText.Text = "⏰ Hourly Boost: Loading..."
bannerText.Parent = eventBanner

-- Listen to Event State
task.spawn(function()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local eventFolder = ReplicatedStorage:WaitForChild("EventState", 15) :: Folder?
    if not eventFolder then return end

    local isBoostActiveObj = eventFolder:WaitForChild("IsBoostActive") :: BoolValue
    local remainingSecObj = eventFolder:WaitForChild("RemainingSeconds") :: IntValue

    local function updateBanner()
        local isActive = isBoostActiveObj.Value
        local sec = remainingSecObj.Value
        local mins = math.floor(sec / 60)
        local secs = sec % 60
        local timeFormatted = string.format("%02d:%02d", mins, secs)

        if isActive then
            bannerStroke.Color = Color3.fromRGB(255, 170, 0)
            eventBanner.BackgroundColor3 = Color3.fromRGB(45, 25, 15)
            bannerText.TextColor3 = Color3.fromRGB(255, 220, 100)
            bannerText.Text = `🔥 1.5x BOOST ACTIVE! ({timeFormatted})`
        else
            bannerStroke.Color = Color3.fromRGB(52, 152, 219)
            eventBanner.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
            bannerText.TextColor3 = Color3.fromRGB(220, 225, 235)
            bannerText.Text = `⏰ Next 1.5x Boost in: {timeFormatted}`
        end
    end

    isBoostActiveObj.Changed:Connect(updateBanner)
    remainingSecObj.Changed:Connect(updateBanner)
    updateBanner()
end)

--------------------------------------------------------------------------------
-- 0.5. Stream Category Selector (📱 IRL on Phone vs 🎮 Gaming / 🎙️ Talk on PC)
--------------------------------------------------------------------------------
local categoryHintLabel = Instance.new("TextLabel")
categoryHintLabel.Name = "CategoryHintLabel"
categoryHintLabel.Size = UDim2.new(0, 420, 0, 18)
categoryHintLabel.Position = UDim2.new(0.5, -210, 0.785, 0)
categoryHintLabel.BackgroundTransparency = 1
categoryHintLabel.Font = Enum.Font.GothamMedium
categoryHintLabel.TextSize = 11
categoryHintLabel.TextColor3 = Color3.fromRGB(200, 215, 240)
categoryHintLabel.Text = "🎮 PC Gaming: Stream at your Computer Battlestation! (+Steam Games Bonus)"
categoryHintLabel.Parent = screenGui

local categoryBar = Instance.new("Frame")
categoryBar.Name = "CategoryBar"
categoryBar.Size = UDim2.new(0, 400, 0, 34)
categoryBar.Position = UDim2.new(0.5, -200, 0.818, 0)
categoryBar.BackgroundTransparency = 1
categoryBar.Parent = screenGui

local catLayout = Instance.new("UIListLayout")
catLayout.FillDirection = Enum.FillDirection.Horizontal
catLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
catLayout.VerticalAlignment = Enum.VerticalAlignment.Center
catLayout.Padding = UDim.new(0, 8)
catLayout.Parent = categoryBar

local function createCategoryBtn(id: string, text: string)
    local btn = Instance.new("TextButton")
    btn.Name = `CatBtn_{id}`
    btn.Size = UDim2.new(0, 124, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(25, 28, 38)
    btn.TextColor3 = Color3.fromRGB(180, 195, 220)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = text
    btn.Parent = categoryBar

    local cCorner = Instance.new("UICorner"); cCorner.CornerRadius = UDim.new(0, 8); cCorner.Parent = btn
    local cStroke = Instance.new("UIStroke"); cStroke.Color = Color3.fromRGB(50, 60, 80); cStroke.Thickness = 1.2; cStroke.Parent = btn

    return btn, cStroke
end

local btnIRL, strokeIRL = createCategoryBtn("IRL", "📱 IRL (Phone)")
local btnGaming, strokeGaming = createCategoryBtn("Gaming", "🎮 Gaming (PC)")
local btnChatting, strokeChatting = createCategoryBtn("JustChatting", "🎙️ Chatting (PC)")

local currentCategory = "Gaming"

local function updateCategoryUI()
    local cat = (LocalPlayer:GetAttribute("StreamCategory") :: string?) or currentCategory
    currentCategory = cat

    -- Reset all
    btnIRL.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
    btnIRL.TextColor3 = Color3.fromRGB(160, 175, 200)
    strokeIRL.Color = Color3.fromRGB(45, 55, 75)
    strokeIRL.Thickness = 1

    btnGaming.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
    btnGaming.TextColor3 = Color3.fromRGB(160, 175, 200)
    strokeGaming.Color = Color3.fromRGB(45, 55, 75)
    strokeGaming.Thickness = 1

    btnChatting.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
    btnChatting.TextColor3 = Color3.fromRGB(160, 175, 200)
    strokeChatting.Color = Color3.fromRGB(45, 55, 75)
    strokeChatting.Thickness = 1

    if cat == "IRL" then
        btnIRL.BackgroundColor3 = Color3.fromRGB(0, 80, 100)
        btnIRL.TextColor3 = Color3.fromRGB(0, 242, 254)
        strokeIRL.Color = Color3.fromRGB(0, 242, 254)
        strokeIRL.Thickness = 2
        categoryHintLabel.Text = "📱 IRL Mode: Mobile stream on phone anywhere! Walk, drive, explore shops."
        categoryHintLabel.TextColor3 = Color3.fromRGB(0, 242, 254)
    elseif cat == "JustChatting" then
        btnChatting.BackgroundColor3 = Color3.fromRGB(70, 45, 10)
        btnChatting.TextColor3 = Color3.fromRGB(255, 180, 50)
        strokeChatting.Color = Color3.fromRGB(255, 160, 20)
        strokeChatting.Thickness = 2
        categoryHintLabel.Text = "🎙️ Just Chatting: Studio talk show on PC! High chat donations & superchats."
        categoryHintLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
    else
        btnGaming.BackgroundColor3 = Color3.fromRGB(55, 25, 80)
        btnGaming.TextColor3 = Color3.fromRGB(210, 140, 255)
        strokeGaming.Color = Color3.fromRGB(180, 90, 255)
        strokeGaming.Thickness = 2
        categoryHintLabel.Text = "🎮 PC Gaming: Stream at your Computer Battlestation! +Bonus from Steam games."
        categoryHintLabel.TextColor3 = Color3.fromRGB(210, 160, 255)
    end
end

local function onCategoryClick(catKey: string)
    currentCategory = catKey
    LocalPlayer:SetAttribute("StreamCategory", catKey)
    setStreamCategoryRemote:FireServer(catKey)
    updateCategoryUI()
end

btnIRL.MouseButton1Click:Connect(function() onCategoryClick("IRL") end)
btnGaming.MouseButton1Click:Connect(function() onCategoryClick("Gaming") end)
btnChatting.MouseButton1Click:Connect(function() onCategoryClick("JustChatting") end)

LocalPlayer:GetAttributeChangedSignal("StreamCategory"):Connect(updateCategoryUI)
updateCategoryUI()

