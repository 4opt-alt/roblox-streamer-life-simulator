			<Item class="ModuleScript" referent="RBX_EnvironmentConfig">
				<Properties>
					<string name="Name">EnvironmentConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict

export type EnvironmentConfigType = {
    -- Скільки РЕАЛЬНИХ секунд триває день і ніч, і де їхні межі на годиннику
    DayLengthSeconds: number,   -- 45 хв реального часу на весь день
    NightLengthSeconds: number, -- 15 хв реального часу на всю ніч
    NightStartHour: number,     -- 21:00 — початок ночі
    NightEndHour: number,       -- 06:00 — кінець ночі (світанок)
    TransitionHours: number,    -- тривалість плавного світанку/заходу (в годинах ігрового часу)
    GeographicLatitude: number,

    -- Освітлення вдень / вночі (Ambient / Brightness)
    DayAmbient: Color3,
    DayOutdoorAmbient: Color3,
    DayBrightness: number,
    NightAmbient: Color3,
    NightOutdoorAmbient: Color3,
    NightBrightness: number,

    -- Atmosphere вдень / вночі (серпанок, сяйво сонця/місяця)
    AtmosphereDensity: number,
    AtmosphereOffset: number,
    DayAtmosphereColor: Color3,
    DayAtmosphereDecay: Color3,
    DayAtmosphereGlare: number,
    DayAtmosphereHaze: number,
    NightAtmosphereColor: Color3,
    NightAtmosphereDecay: Color3,
    NightAtmosphereGlare: number,
    NightAtmosphereHaze: number,

    -- Глобальні рухомі хмари (колір міняється між днем і ніччю)
    CloudsCover: number,
    CloudsDensity: number,
    DayCloudsColor: Color3,
    NightCloudsColor: Color3,
}

local EnvironmentConfig: EnvironmentConfigType = {
    DayLengthSeconds = 45 * 60,
    NightLengthSeconds = 15 * 60,
    NightStartHour = 21,
    NightEndHour = 6,
    TransitionHours = 0.75,
    GeographicLatitude = 35,

    DayAmbient = Color3.fromRGB(140, 145, 165),
    DayOutdoorAmbient = Color3.fromRGB(150, 165, 195),
    DayBrightness = 2.6,
    NightAmbient = Color3.fromRGB(35, 38, 58),
    NightOutdoorAmbient = Color3.fromRGB(25, 28, 46),
    NightBrightness = 0.9,

    AtmosphereDensity = 0.3,
    AtmosphereOffset = 0.25,
    DayAtmosphereColor = Color3.fromRGB(199, 199, 199),
    DayAtmosphereDecay = Color3.fromRGB(112, 125, 153),
    DayAtmosphereGlare = 0.2,
    DayAtmosphereHaze = 1.3,
    NightAtmosphereColor = Color3.fromRGB(40, 45, 70),
    NightAtmosphereDecay = Color3.fromRGB(18, 20, 35),
    NightAtmosphereGlare = 0,
    NightAtmosphereHaze = 1.7,

    CloudsCover = 0.38,
    CloudsDensity = 0.55,
    DayCloudsColor = Color3.fromRGB(255, 255, 255),
    NightCloudsColor = Color3.fromRGB(120, 130, 160),
}

return EnvironmentConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_PhoneConfig">
				<Properties>
					<string name="Name">PhoneConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Конфіг телефону та "творчої економіки" контент-мейкера.
-- Іконки/назви застосунків навмисно ВИГАДАНІ (не справжні лого TikTok/YouTube/
-- Twitch) — просто емодзі + власні бренди, щоб нічиїх авторських прав не
-- порушувати. ClipZap — аналог TikTok (завжди відкритий), WatchBox — аналог
-- YouTube, LiveWave — аналог Twitch (обидва розблоковуються пізніше, коли
-- набереться достатньо підписників).

export type AppConfig = {
	Id: string,
	DisplayName: string,
	Icon: string,
	AccentColor: Color3,
	UnlockFollowers: number, -- 0 = розблоковано з самого початку
}

local PhoneConfig = {}

PhoneConfig.Apps = {
	{
		Id = "ClipZap",
		DisplayName = "ClipZap",
		Icon = "🎬",
		AccentColor = Color3.fromRGB(255, 45, 110),
		UnlockFollowers = 0,
	} :: AppConfig,
	{
		Id = "WatchBox",
		DisplayName = "WatchBox",
		Icon = "📺",
		AccentColor = Color3.fromRGB(230, 60, 60),
		UnlockFollowers = 100,
	} :: AppConfig,
	{
		Id = "LiveWave",
		DisplayName = "LiveWave",
		Icon = "🎥",
		AccentColor = Color3.fromRGB(150, 90, 255),
		UnlockFollowers = 500,
	} :: AppConfig,
}

-- Баланс "творчої економіки": скільки лайків/підписників приносить одне
-- відео в ClipZap, і скільки доларів капає за кожні N лайків.
PhoneConfig.Economy = {
	LikesPerDollar = 10,
	MinLikesPerVideo = 5,
	MaxLikesPerVideo = 60,
	MinFollowersPerVideo = 1,
	MaxFollowersPerVideo = 8,
	RecordSeconds = 4,   -- скільки триває анімація запису на клієнті
	CooldownSeconds = 2, -- пауза між відео після публікації
}

return PhoneConfig
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX_ServerScriptService">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX_EnvironmentManager">
			<Properties>
				<string name="Name">EnvironmentManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EnvironmentConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("EnvironmentConfig") :: ModuleScript)

Lighting.GeographicLatitude = EnvironmentConfig.GeographicLatitude
Lighting.ClockTime = 12 -- старт ігрового дня о яскравому полудні

--------------------------------------------------------------------------------
-- Sky: небесна сфера з сонцем, місяцем і зірками (вбудований рушій Roblox,
-- сам показує/приховує місяць і зірки залежно від часу доби)
--------------------------------------------------------------------------------
local sky = Lighting:FindFirstChildOfClass("Sky")
if not sky then
    sky = Instance.new("Sky")
    sky.Parent = Lighting
end

--------------------------------------------------------------------------------
-- Atmosphere: серпанок і сяйво навколо сонця/місяця
--------------------------------------------------------------------------------
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
if not atmosphere then
    atmosphere = Instance.new("Atmosphere")
    atmosphere.Parent = Lighting
end
atmosphere.Density = EnvironmentConfig.AtmosphereDensity
atmosphere.Offset = EnvironmentConfig.AtmosphereOffset

--------------------------------------------------------------------------------
-- Глобальні рухомі хмари (вбудований шар Roblox, анімується сам у небі)
--------------------------------------------------------------------------------
local clouds = Workspace:FindFirstChildOfClass("Clouds")
if not clouds then
    clouds = Instance.new("Clouds")
    clouds.Parent = Workspace
end
clouds.Cover = EnvironmentConfig.CloudsCover
clouds.Density = EnvironmentConfig.CloudsDensity

--------------------------------------------------------------------------------
-- Цикл дня і ночі: 45 хв день + 15 хв ніч, з плавним світанком/заходом.
-- Годинник рухається різною швидкістю вдень і вночі (не лінійно по колу),
-- щоб реальний час дня/ночі точно збігався з таймінгом з конфігу.
--------------------------------------------------------------------------------
local function hoursBetween(fromHour: number, toHour: number): number
    -- Кількість годин по колу від fromHour до toHour (з переходом через 24 за потреби)
    local diff = toHour - fromHour
    if diff <= 0 then
        diff += 24
    end
    return diff
end

local nightHours = hoursBetween(EnvironmentConfig.NightStartHour, EnvironmentConfig.NightEndHour)
local dayHours = 24 - nightHours

local dayRatePerSecond = dayHours / EnvironmentConfig.DayLengthSeconds
local nightRatePerSecond = nightHours / EnvironmentConfig.NightLengthSeconds

local function isNightClockTime(clockTime: number): boolean
    if EnvironmentConfig.NightStartHour > EnvironmentConfig.NightEndHour then
        return clockTime >= EnvironmentConfig.NightStartHour or clockTime < EnvironmentConfig.NightEndHour
    else
        return clockTime >= EnvironmentConfig.NightStartHour and clockTime < EnvironmentConfig.NightEndHour
    end
end

-- 0 = повна ніч, 1 = повний день, плавно на межах світанку/заходу
local function getDayFactor(clockTime: number): number
    local sinceDawn = hoursBetween(EnvironmentConfig.NightEndHour, clockTime)
    local transition = math.max(0.01, EnvironmentConfig.TransitionHours)

    if sinceDawn < transition then
        return sinceDawn / transition -- світанок: 0 -> 1
    elseif sinceDawn < dayHours - transition then
        return 1 -- повний день
    elseif sinceDawn < dayHours then
        return (dayHours - sinceDawn) / transition -- захід: 1 -> 0
    else
        return 0 -- повна ніч
    end
end

task.spawn(function()
    while true do
        task.wait(1)

        local night = isNightClockTime(Lighting.ClockTime)
        local rate = night and nightRatePerSecond or dayRatePerSecond
        Lighting.ClockTime = (Lighting.ClockTime + rate) % 24

        local dayFactor = getDayFactor(Lighting.ClockTime)

        Lighting.Ambient = EnvironmentConfig.NightAmbient:Lerp(EnvironmentConfig.DayAmbient, dayFactor)
        Lighting.OutdoorAmbient = EnvironmentConfig.NightOutdoorAmbient:Lerp(EnvironmentConfig.DayOutdoorAmbient, dayFactor)
        Lighting.Brightness = EnvironmentConfig.NightBrightness
            + (EnvironmentConfig.DayBrightness - EnvironmentConfig.NightBrightness) * dayFactor

        atmosphere.Color = EnvironmentConfig.NightAtmosphereColor:Lerp(EnvironmentConfig.DayAtmosphereColor, dayFactor)
        atmosphere.Decay = EnvironmentConfig.NightAtmosphereDecay:Lerp(EnvironmentConfig.DayAtmosphereDecay, dayFactor)
        atmosphere.Glare = EnvironmentConfig.NightAtmosphereGlare
            + (EnvironmentConfig.DayAtmosphereGlare - EnvironmentConfig.NightAtmosphereGlare) * dayFactor
        atmosphere.Haze = EnvironmentConfig.NightAtmosphereHaze
            + (EnvironmentConfig.DayAtmosphereHaze - EnvironmentConfig.NightAtmosphereHaze) * dayFactor

        clouds.Color = EnvironmentConfig.NightCloudsColor:Lerp(EnvironmentConfig.DayCloudsColor, dayFactor)
    end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_CreatorEconomyManager">
			<Properties>
				<string name="Name">CreatorEconomyManager</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Керує "творчою економікою" гравця: підписники (Followers) та гроші (Money)
-- у leaderstats, плюс ChannelStats (TotalLikes, VideoCount) для профілю
-- каналу на телефоні — усе це прибуває після запису відео в ClipZap.
-- Сервер — єдине джерело правди для випадкових чисел (лайки/підписники за
-- відео) і для кулдауну, щоб клієнт нічого не міг підробити чи проспамити.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PhoneConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PhoneConfig"))
local Economy = PhoneConfig.Economy

-- Remotes створюються тут же в рантаймі (не потрібно запікати їх в XML мапи) —
-- клієнтський PhoneController.client.luau просто чекає на них через WaitForChild.
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local recordVideoRequest = Instance.new("RemoteEvent")
recordVideoRequest.Name = "RecordVideoRequest"
recordVideoRequest.Parent = remotes

local recordVideoResult = Instance.new("RemoteEvent")
recordVideoResult.Name = "RecordVideoResult"
recordVideoResult.Parent = remotes

-- userId -> момент часу (os.clock()), коли гравцю знову можна записувати відео
local nextRecordAllowedAt: { [number]: number } = {}

Players.PlayerAdded:Connect(function(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	-- Illia попросив: гравець "прокидається бідняком" — стартові 0 підписників, 0$.
	local followers = Instance.new("IntValue")
	followers.Name = "Followers"
	followers.Value = 0
	followers.Parent = leaderstats

	local money = Instance.new("IntValue")
	money.Name = "Money"
	money.Value = 0
	money.Parent = leaderstats

	-- Окрема папка (НЕ leaderstats) для профілю каналу на телефоні — щоб не
	-- додавати зайві колонки в стандартний Roblox-лідерборд. Ці значення
	-- показуються в шапці ClipZap (❤️ лайки, 👥 підписники, 🎬 відео).
	local channelStats = Instance.new("Folder")
	channelStats.Name = "ChannelStats"
	channelStats.Parent = player

	local totalLikes = Instance.new("IntValue")
	totalLikes.Name = "TotalLikes"
	totalLikes.Value = 0
	totalLikes.Parent = channelStats

	local videoCount = Instance.new("IntValue")
	videoCount.Name = "VideoCount"
	videoCount.Value = 0
	videoCount.Parent = channelStats
end)

Players.PlayerRemoving:Connect(function(player: Player)
	nextRecordAllowedAt[player.UserId] = nil
end)

recordVideoRequest.OnServerEvent:Connect(function(player: Player)
	local now = os.clock()
	local readyAt = nextRecordAllowedAt[player.UserId] or 0
	if now < readyAt then
		-- Ще на кулдауні (або клієнт намагається спамити) — тихо відмовляємо.
		recordVideoResult:FireClient(player, { Success = false })
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local followers = leaderstats:FindFirstChild("Followers") :: IntValue?
	local money = leaderstats:FindFirstChild("Money") :: IntValue?
	if not followers or not money then
		return
	end

	local likes = math.random(Economy.MinLikesPerVideo, Economy.MaxLikesPerVideo)
	local gainedFollowers = math.random(Economy.MinFollowersPerVideo, Economy.MaxFollowersPerVideo)
	local gainedMoney = math.floor(likes / Economy.LikesPerDollar)

	followers.Value += gainedFollowers
	money.Value += gainedMoney

	local channelStats = player:FindFirstChild("ChannelStats")
	if channelStats then
		local totalLikes = channelStats:FindFirstChild("TotalLikes") :: IntValue?
		local videoCount = channelStats:FindFirstChild("VideoCount") :: IntValue?
		if totalLikes then
			totalLikes.Value += likes
		end
		if videoCount then
			videoCount.Value += 1
		end
	end

	-- Кулдаун рахуємо від моменту публікації, а не запиту — щоб врахувати і
	-- саму "зйомку" на клієнті, і паузу між відео.
	nextRecordAllowedAt[player.UserId] = now + Economy.RecordSeconds + Economy.CooldownSeconds

	recordVideoResult:FireClient(player, {
		Success = true,
		Likes = likes,
		Followers = gainedFollowers,
		Money = gainedMoney,
	})
end)
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX_StarterPlayer">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX_StarterPlayerScripts">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX_PhoneController">
				<Properties>
					<string name="Name">PhoneController</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Телефон гравця: маленька підказка "[P] Take out phone", сам телефон, який
-- живе з ПРАВОГО боку екрана (не закриває вид на персонажа), з 3 іконками
-- застосунків (ClipZap відкритий одразу, WatchBox і LiveWave розблоковуються
-- пізніше за підписниками) і механіка запису відео в ClipZap: під час зйомки
-- камера випадково обирає один із 3 ракурсів (селфі/оберт навколо/знизу), а
-- персонаж — одну з 7 стандартних емоцій Roblox, і на екрані з'являється
-- REC-індикатор — щоб виглядало так, ніби гравець реально знімає контент, і
-- щоб відео не здавались однотипними. За відео капають лайки -> підписники +
-- гроші (кожні 10 лайків = $1).
--
-- ClipZap відкривається профілем каналу: аватарка (справжній аватар гравця
-- Roblox), нікнейм, який гравець вписує сам при ПЕРШОМУ відкритті ClipZap
-- (і більше не питається — той самий нік потім "переноситься" й на WatchBox/
-- LiveWave), і статистика (лайки/підписники/відео).
--
-- ПРИМІТКА: усі тексти, які бачить гравець, англійською (стандартне правило
-- проєкту від Illia). Коментарі лишаються українською.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PhoneConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PhoneConfig"))
local Economy = PhoneConfig.Economy

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local recordVideoRequest = remotes:WaitForChild("RecordVideoRequest") :: RemoteEvent
local recordVideoResult = remotes:WaitForChild("RecordVideoResult") :: RemoteEvent

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
local leaderstats = LocalPlayer:WaitForChild("leaderstats")
local followersStat = leaderstats:WaitForChild("Followers") :: IntValue
local moneyStat = leaderstats:WaitForChild("Money") :: IntValue

-- Профільна статистика каналу (окрема папка, не leaderstats, щоб не
-- засмічувати стандартний Roblox-лідерборд зайвими колонками).
local channelStats = LocalPlayer:WaitForChild("ChannelStats")
local totalLikesStat = channelStats:WaitForChild("TotalLikes") :: IntValue
local videoCountStat = channelStats:WaitForChild("VideoCount") :: IntValue

-- ============================================================
-- Стан
-- ============================================================
local phoneOpen = false
local isAnimating = false
local recording = false
local cooldownUntil = 0

-- Нікнейм каналу — гравець вписує його сам при першому відкритті ClipZap,
-- і той самий нік потім використовується і в WatchBox, і в LiveWave.
-- Зберігається лише локально на клієнті (не надсилається на сервер і не
-- видно іншим гравцям), тому фільтрація чату (TextService) тут не потрібна.
local channelNickname: string? = nil

local showPage: (string) -> ()
local refreshStats: () -> ()
local refreshClipZapView: () -> ()
local recordButton: TextButton
local recordStatusLabel: TextLabel
local avatarImage: ImageLabel
local nicknameLabel: TextLabel
local likesStatLabel: TextLabel
local channelFollowersLabel: TextLabel
local videosStatLabel: TextLabel
local nicknameSetupFrame: Frame
local channelContent: Frame
local nicknameBox: TextBox
local setupError: TextLabel

-- Сторінки WatchBox/LiveWave підписуються сюди, щоб дізнатись, коли гравець
-- нарешті вписав нік у ClipZap, і оновити свій "@нік перенесеться" напис.
local nicknameWatchers: { () -> () } = {}

-- Аватарка каналу — беремо справжній аватар гравця Roblox (офіційний API,
-- жодного підбору asset-ID). Запускаємо запит одразу, а не чекаємо, поки
-- гравець відкриє ClipZap, щоб на момент відкриття картинка вже була готова.
local avatarContent = ""
task.spawn(function()
	local ok, content = pcall(function()
		return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
	end)
	if ok and content then
		avatarContent = content
		if avatarImage then
			avatarImage.Image = content
		end
	end
end)

-- ============================================================
-- Корінь GUI
-- ============================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PhoneGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

-- ============================================================
-- Вступний тост при спавні — на 1 сесію, ненав'язливий, зникає сам
-- ============================================================
local introToast = Instance.new("TextLabel")
introToast.Name = "IntroToast"
introToast.Size = UDim2.new(0, 380, 0, 54)
introToast.AnchorPoint = Vector2.new(0.5, 0)
introToast.Position = UDim2.new(0.5, 0, 0, 22)
introToast.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
introToast.BorderSizePixel = 0
introToast.Font = Enum.Font.Gotham
introToast.TextSize = 14
introToast.TextWrapped = true
introToast.TextColor3 = Color3.fromRGB(230, 233, 240)
introToast.TextTransparency = 1
introToast.BackgroundTransparency = 1
introToast.Text = "You woke up at the scrapyard without a penny. Time to film videos on ClipZap and become a star! 🎬"
introToast.Parent = screenGui
local introCorner = Instance.new("UICorner")
introCorner.CornerRadius = UDim.new(0, 14)
introCorner.Parent = introToast

task.spawn(function()
	task.wait(1.2)
	TweenService:Create(introToast, TweenInfo.new(0.5), { TextTransparency = 0, BackgroundTransparency = 0.15 }):Play()
	task.wait(6.5)
	TweenService:Create(introToast, TweenInfo.new(0.6), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
end)

-- ============================================================
-- Підказка: "▲ Take out phone" — маленька, приємна, клікабельна, в
-- нижньому правому куті (там-таки, звідки виїжджає сам телефон)
-- ============================================================
local hintButton = Instance.new("TextButton")
hintButton.Name = "PhoneHint"
hintButton.Size = UDim2.new(0, 190, 0, 40)
hintButton.AnchorPoint = Vector2.new(1, 1)
hintButton.Position = UDim2.new(1, -20, 1, -26)
hintButton.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
hintButton.BackgroundTransparency = 0.28
hintButton.BorderSizePixel = 0
hintButton.AutoButtonColor = false
hintButton.Text = ""
hintButton.Parent = screenGui

local hintCorner = Instance.new("UICorner")
hintCorner.CornerRadius = UDim.new(1, 0)
hintCorner.Parent = hintButton

local hintStroke = Instance.new("UIStroke")
hintStroke.Color = Color3.fromRGB(255, 255, 255)
hintStroke.Transparency = 0.75
hintStroke.Thickness = 1
hintStroke.Parent = hintButton

-- Раніше тут була стрілка "▲" (стрілка вверх), але саму стрілку вверх Roblox
-- за замовчуванням перехоплює як клавішу руху персонажа (аналог W) — тобто
-- UserInputService бачить її як "gameProcessed = true" і наш обробник нижче
-- її просто ігнорував. Тому підказку й сам бінд перенесли на клавішу "P",
-- яка нічим стандартним не зайнята. Малюємо її як маленьку "клавішу-кнопку".
local hintArrow = Instance.new("TextLabel")
hintArrow.Name = "KeyBadge"
hintArrow.AnchorPoint = Vector2.new(0, 0.5)
hintArrow.Position = UDim2.new(0, 14, 0.5, 0)
hintArrow.Size = UDim2.new(0, 22, 0, 22)
hintArrow.BackgroundColor3 = Color3.fromRGB(120, 210, 255)
hintArrow.BackgroundTransparency = 0.05
hintArrow.BorderSizePixel = 0
hintArrow.Font = Enum.Font.GothamBold
hintArrow.Text = "P"
hintArrow.TextSize = 15
hintArrow.TextColor3 = Color3.fromRGB(14, 16, 22)
hintArrow.Parent = hintButton

local hintArrowCorner = Instance.new("UICorner")
hintArrowCorner.CornerRadius = UDim.new(0, 6)
hintArrowCorner.Parent = hintArrow

local hintText = Instance.new("TextLabel")
hintText.Name = "Label"
hintText.AnchorPoint = Vector2.new(0, 0.5)
hintText.Position = UDim2.new(0, 46, 0.5, 0)
hintText.Size = UDim2.new(0, 140, 0, 20)
hintText.BackgroundTransparency = 1
hintText.Font = Enum.Font.Gotham
hintText.Text = "Take out phone"
hintText.TextSize = 14
hintText.TextColor3 = Color3.fromRGB(235, 238, 245)
hintText.TextXAlignment = Enum.TextXAlignment.Left
hintText.Parent = hintButton

-- Легка пульсація значка клавіші — привертає погляд, але не дратує
task.spawn(function()
	while hintArrow.Parent do
		local up = TweenService:Create(hintArrow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0, 14, 0.5, -4) })
		local down = TweenService:Create(hintArrow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.new(0, 14, 0.5, 0) })
		up:Play()
		up.Completed:Wait()
		down:Play()
		down.Completed:Wait()
		task.wait(0.5)
	end
end)

-- ============================================================
-- REC-індикатор і червона рамка — з'являються під час зйомки, щоб було
-- видно, що персонаж реально щось знімає (Illia попросив саме це)
-- ============================================================
local recHud = Instance.new("Frame")
recHud.Name = "RecordingHud"
recHud.Size = UDim2.new(0, 130, 0, 38)
recHud.AnchorPoint = Vector2.new(0.5, 0)
recHud.Position = UDim2.new(0.5, 0, 0, 22)
recHud.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
recHud.BackgroundTransparency = 0.2
recHud.BorderSizePixel = 0
recHud.Visible = false
recHud.Parent = screenGui
local recHudCorner = Instance.new("UICorner")
recHudCorner.CornerRadius = UDim.new(1, 0)
recHudCorner.Parent = recHud

local recDot = Instance.new("Frame")
recDot.Name = "Dot"
recDot.AnchorPoint = Vector2.new(0, 0.5)
recDot.Position = UDim2.new(0, 14, 0.5, 0)
recDot.Size = UDim2.new(0, 12, 0, 12)
recDot.BackgroundColor3 = Color3.fromRGB(255, 45, 60)
recDot.BorderSizePixel = 0
recDot.Parent = recHud
local recDotCorner = Instance.new("UICorner")
recDotCorner.CornerRadius = UDim.new(1, 0)
recDotCorner.Parent = recDot

local recLabel = Instance.new("TextLabel")
recLabel.Name = "Label"
recLabel.AnchorPoint = Vector2.new(0, 0.5)
recLabel.Position = UDim2.new(0, 34, 0.5, 0)
recLabel.Size = UDim2.new(0, 90, 0, 22)
recLabel.BackgroundTransparency = 1
recLabel.Font = Enum.Font.GothamBold
recLabel.TextSize = 14
recLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
recLabel.TextXAlignment = Enum.TextXAlignment.Left
recLabel.Text = "REC"
recLabel.Parent = recHud

-- Тонка пульсуюча червона рамка по краях екрана — легкий "camera app" вайб
local recBorder = Instance.new("Frame")
recBorder.Name = "RecordingBorder"
recBorder.Size = UDim2.new(1, 0, 1, 0)
recBorder.BackgroundTransparency = 1
recBorder.Visible = false
recBorder.Parent = screenGui
local recBorderStroke = Instance.new("UIStroke")
recBorderStroke.Color = Color3.fromRGB(255, 40, 60)
recBorderStroke.Thickness = 4
recBorderStroke.Transparency = 0.4
recBorderStroke.Parent = recBorder

local recDotPulseRunning = false
local function startRecDotPulse()
	if recDotPulseRunning then
		return
	end
	recDotPulseRunning = true
	task.spawn(function()
		while recHud.Visible do
			local fadeOut = TweenService:Create(recDot, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.75 })
			fadeOut:Play()
			fadeOut.Completed:Wait()
			if not recHud.Visible then
				break
			end
			local fadeIn = TweenService:Create(recDot, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0 })
			fadeIn:Play()
			fadeIn.Completed:Wait()
		end
		recDot.BackgroundTransparency = 0
		recDotPulseRunning = false
	end)
end

-- ============================================================
-- Камера + анімація персонажа під час зйомки відео. Illia попросив
-- різноманіття, щоб відео не здавались однотипними — тому тут і набір із
-- 7 РІЗНИХ стандартних емоцій Roblox (не тільки танці), і 3 РІЗНІ ракурси
-- камери, обидва обираються випадково щоразу -> 21 унікальна комбінація.
--
-- Свідомо використовуємо ТІЛЬКИ Humanoid:PlayEmote() з іменами, які вже
-- зареєстровані в стандартному Animate-скрипті будь-якого персонажа Roblox
-- за замовчуванням (а не жорстко вбиті AnimationId) — це гарантовано existing
-- і безпечно, без ризику "не той asset" (як було раніше з підбором звуку
-- для гіроскутера в цьому ж проєкті).
-- ============================================================
local ACTION_EMOTES = { "dance1", "dance2", "dance3", "wave", "point", "laugh", "cheer" }
local CAMERA_STYLES = { "selfie", "orbit", "lowAngle" }

local cameraConnection: RBXScriptConnection? = nil
local activeEmoteTrack: AnimationTrack? = nil
local originalCameraType: Enum.CameraType? = nil

-- Рахує CFrame камери для обраного ракурсу; progress іде 0 -> 1 протягом
-- усієї зйомки (потрібен для "orbit", який плавно облітає персонажа).
local function computeCameraCFrame(style: string, head: BasePart, hrp: BasePart, progress: number): CFrame
	local lookVector = hrp.CFrame.LookVector
	if style == "orbit" then
		-- Камера оператора, що повільно облітає персонажа по колу.
		local angle = math.rad(progress * 200 - 40)
		local radius = 9
		local orbitOffset = Vector3.new(math.cos(angle) * radius, 2.6, math.sin(angle) * radius)
		local camPos = hrp.Position + orbitOffset
		return CFrame.lookAt(camPos, head.Position)
	elseif style == "lowAngle" then
		-- Драматичний нижній ракурс, як у кліпах — камера знизу-спереду.
		local camPos = head.Position + lookVector * 5 - Vector3.new(0, 2.6, 0)
		return CFrame.lookAt(camPos, head.Position + Vector3.new(0, 0.6, 0))
	else
		-- "selfie": камера висить попереду персонажа й дивиться назад —
		-- класичний ракурс "зняв себе на телефон".
		local camPos = head.Position + lookVector * 6 + Vector3.new(0, 1.1, 0)
		local focusPos = head.Position + Vector3.new(0, 0.2, 0)
		return CFrame.lookAt(camPos, focusPos)
	end
end

local function startRecordingCamera(recordSeconds: number)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head") :: BasePart?
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (character and humanoid and head and hrp) then
		return
	end

	local emoteName = ACTION_EMOTES[math.random(1, #ACTION_EMOTES)]
	local ok, track = pcall(function()
		return (humanoid :: Humanoid):PlayEmote(emoteName)
	end)
	if ok and track then
		activeEmoteTrack = track :: AnimationTrack
	end

	local cameraStyle = CAMERA_STYLES[math.random(1, #CAMERA_STYLES)]
	local startClock = os.clock()

	local camera = workspace.CurrentCamera
	if camera then
		originalCameraType = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
		cameraConnection = RunService.RenderStepped:Connect(function()
			if not (head.Parent and hrp.Parent) then
				return
			end
			local progress = math.clamp((os.clock() - startClock) / recordSeconds, 0, 1)
			camera.CFrame = computeCameraCFrame(cameraStyle, head, hrp, progress)
		end)
	end
end

local function stopRecordingCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end
	local camera = workspace.CurrentCamera
	if camera and originalCameraType then
		camera.CameraType = originalCameraType
	end
	originalCameraType = nil
	if activeEmoteTrack then
		activeEmoteTrack:Stop(0.3)
		activeEmoteTrack = nil
	end
end

