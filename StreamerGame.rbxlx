			<Item class="LocalScript" referent="RBX_StreamController">
				<Properties>
					<string name="Name">StreamController</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

-- Load Shared Config
local StreamConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("StreamConfig") :: ModuleScript)

-- Connect to RemoteEvents
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local toggleStreamRemote = remotesFolder:WaitForChild("ToggleStream") :: RemoteEvent
local streamStateChangedRemote = remotesFolder:WaitForChild("StreamStateChanged") :: RemoteEvent
local setChannelNameRemote = remotesFolder:WaitForChild("SetChannelName") :: RemoteEvent

-- Wait for UI elements
local streamGui = PlayerGui:WaitForChild("StreamGui") :: ScreenGui
local streamButton = streamGui:WaitForChild("StreamButton") :: TextButton

-- Streamer Hub, Channel Bar & Chat Panel
local streamerHub = streamGui:WaitForChild("StreamerHub", 10) :: Frame?
local channelBar = (streamerHub and streamerHub:WaitForChild("ChannelBar", 5)) or streamGui:WaitForChild("ChannelBar") :: Frame
local channelTitleLabel = channelBar:WaitForChild("ChannelTitleLabel") :: TextLabel
local editChannelButton = channelBar:WaitForChild("EditChannelButton") :: TextButton

local chatContainer = (streamerHub and streamerHub:WaitForChild("ChatContainer", 5)) or streamGui:WaitForChild("ChatContainer") :: Frame
local chatHeader = chatContainer:WaitForChild("ChatHeader") :: TextLabel
local scrollingFrame = chatContainer:WaitForChild("ChatScrollingFrame") :: ScrollingFrame

-- Modal Popup
local modalBackdrop = streamGui:WaitForChild("ChannelModalBackdrop") :: Frame
local modalBox = modalBackdrop:WaitForChild("ModalBox") :: Frame
local channelInputBox = modalBox:WaitForChild("ChannelInputBox") :: TextBox
local saveChannelButton = modalBox:WaitForChild("SaveChannelButton") :: TextButton
local closeModalButton = modalBox:WaitForChild("CloseModalButton") :: TextButton

local isLocalStreaming = false
local messageCount = 0

--------------------------------------------------------------------------------
-- Update Channel Name in UI
--------------------------------------------------------------------------------
local function updateChannelDisplay()
    local currentChannel = LocalPlayer:GetAttribute("ChannelName") or (LocalPlayer.DisplayName .. " TV")
    channelTitleLabel.Text = `📺 Channel: {currentChannel}`
    channelInputBox.Text = tostring(currentChannel)
end

updateChannelDisplay()
LocalPlayer:GetAttributeChangedSignal("ChannelName"):Connect(updateChannelDisplay)

--------------------------------------------------------------------------------
-- Modal Controls
--------------------------------------------------------------------------------
local function openModal()
    updateChannelDisplay()
    modalBackdrop.Visible = true
    channelInputBox:CaptureFocus()
end

local function closeModal()
    modalBackdrop.Visible = false
end

editChannelButton.MouseButton1Click:Connect(openModal)
closeModalButton.MouseButton1Click:Connect(closeModal)

saveChannelButton.MouseButton1Click:Connect(function()
    local input = channelInputBox.Text
    local cleaned = string.gsub(input, "^%s*(.-)%s*$", "%1")

    if #cleaned >= StreamConfig.MinChannelNameLength and #cleaned <= StreamConfig.MaxChannelNameLength then
        setChannelNameRemote:FireServer(cleaned)
        closeModal()
    else
        channelInputBox.PlaceholderText = "Between 3 and 20 characters!"
        channelInputBox.Text = ""
    end
end)

-- Prompt player to name channel on first join if default
task.delay(1.5, function()
    local currentChannel = LocalPlayer:GetAttribute("ChannelName")
    if not currentChannel or currentChannel == (LocalPlayer.DisplayName .. " TV") then
        openModal()
    end
end)

--------------------------------------------------------------------------------
-- Chat Feed Logic
--------------------------------------------------------------------------------
local function addComment(author: string, rawText: string)
    messageCount += 1

    local currentChannel = LocalPlayer:GetAttribute("ChannelName") or LocalPlayer.DisplayName
    -- Replace {channel} placeholder with actual channel name
    local formattedText = string.gsub(rawText, "{channel}", tostring(currentChannel))

    local messageLabel = Instance.new("TextLabel")
    messageLabel.Name = `Msg_{messageCount}`
    messageLabel.LayoutOrder = messageCount
    messageLabel.Size = UDim2.new(1, 0, 0, 0)
    messageLabel.BackgroundTransparency = 1
    messageLabel.Font = Enum.Font.Gotham
    messageLabel.TextSize = 13
    messageLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
    messageLabel.TextWrapped = true
    messageLabel.TextXAlignment = Enum.TextXAlignment.Left
    messageLabel.TextYAlignment = Enum.TextYAlignment.Top
    messageLabel.AutomaticSize = Enum.AutomaticSize.Y
    messageLabel.RichText = true

    local nameColors = { "#4FC3F7", "#81C784", "#FFD54F", "#FF8A65", "#BA68C8", "#4DB6AC" }
    local chosenColor = nameColors[math.random(1, #nameColors)]

    messageLabel.Text = `<b><font color="{chosenColor}">@{author}</font></b>: {formattedText}`
    messageLabel.Parent = scrollingFrame

    -- Trim old messages to conserve memory
    local allMessages = scrollingFrame:GetChildren()
    local textLabels = {}
    for _, child in allMessages do
        if child:IsA("TextLabel") then
            table.insert(textLabels, child)
        end
    end

    if #textLabels > StreamConfig.MaxChatHistory then
        table.sort(textLabels, function(a, b)
            return a.LayoutOrder < b.LayoutOrder
        end)
        textLabels[1]:Destroy()
    end

    -- Auto-scroll
    task.defer(function()
        scrollingFrame.CanvasPosition = Vector2.new(0, 999999)
    end)
end

local function startCommentLoop()
    task.spawn(function()
        local currentChannel = LocalPlayer:GetAttribute("ChannelName") or LocalPlayer.DisplayName
        addComment("SYSTEM", `Stream started on «{currentChannel}»! Viewers are tuning in...`)

        while isLocalStreaming do
            local interval = math.random(
                math.floor(StreamConfig.CommentIntervalMin * 10),
                math.floor(StreamConfig.CommentIntervalMax * 10)
            ) / 10

            task.wait(interval)
            if not isLocalStreaming then
                break
            end

            local randomName = StreamConfig.ViewerNames[math.random(1, #StreamConfig.ViewerNames)]
            local gamesCount = LocalPlayer:GetAttribute("GamesOwnedCount") or 0
            local energy = (LocalPlayer:GetAttribute("Energy") :: number?) or 100
            local gearCount = LocalPlayer:GetAttribute("GearOwnedCount") or 0

            local commentPool = StreamConfig.ViewerComments
            local catKey = (LocalPlayer:GetAttribute("StreamCategory") :: string?) or "Gaming"

            if energy < 25 and #StreamConfig.LowEnergyComments > 0 then
                -- Втомлений стрімер
                commentPool = StreamConfig.LowEnergyComments
            elseif catKey == "Gaming" and gamesCount == 0 and #StreamConfig.NoGameComments > 0 and math.random() < 0.65 then
                -- Стрімер без ігор
                commentPool = StreamConfig.NoGameComments
            elseif catKey == "IRL" and StreamConfig.IRLComments and #StreamConfig.IRLComments > 0 and math.random() < 0.60 then
                commentPool = StreamConfig.IRLComments
            elseif catKey == "Gaming" and StreamConfig.GamingComments and #StreamConfig.GamingComments > 0 and math.random() < 0.60 then
                commentPool = StreamConfig.GamingComments
            elseif catKey == "JustChatting" and StreamConfig.JustChattingComments and #StreamConfig.JustChattingComments > 0 and math.random() < 0.60 then
                commentPool = StreamConfig.JustChattingComments
            elseif gearCount >= 3 and #StreamConfig.ProComments > 0 and math.random() < 0.5 then
                -- Крутий стрімер з топовим сетапом
                commentPool = StreamConfig.ProComments
            end

            local randomText = commentPool[math.random(1, #commentPool)]
            addComment(randomName, randomText)
        end

        addComment("SYSTEM", "Stream ended. Thanks for watching everyone!")
    end)
end

--------------------------------------------------------------------------------
-- Stream Toggle Interaction with Platform Selection & Category Checks
--------------------------------------------------------------------------------
streamButton.MouseButton1Click:Connect(function()
    if isLocalStreaming then
        -- Stop stream directly
        toggleStreamRemote:FireServer()
    else
        local lockedPlat = LocalPlayer:GetAttribute("LockedPlatform")
        if not lockedPlat or lockedPlat == "" then
            -- Platform not selected yet: open contract selection window
            if _G.OpenPlatformSelect then
                _G.OpenPlatformSelect(false)
            end
            return
        end

        local catKey = (LocalPlayer:GetAttribute("StreamCategory") :: string?) or "Gaming"
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local deskPos = Vector3.new(0, 4.5, -70)

        if (catKey == "Gaming" or catKey == "JustChatting") and root then
            local dist = (root.Position - deskPos).Magnitude
            if dist > 24 then
                addComment("SYSTEM", "⚠️ You must be at your Computer Battlestation to stream Gaming or Just Chatting! (Sit at your PC or switch to 📱 IRL)")
                return
            end
        end

        -- Stream directly with locked contract!
        toggleStreamRemote:FireServer(lockedPlat)
    end
end)

-- Prompt platform contract choice on join if not locked yet
task.delay(2.5, function()
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    if not locked or locked == "" then
        if _G.OpenPlatformSelect then
            _G.OpenPlatformSelect(false)
        end
    end
end)

streamStateChangedRemote.OnClientEvent:Connect(function(streamingState: boolean, platformKey: string?)
    isLocalStreaming = streamingState
    local currentChannel = LocalPlayer:GetAttribute("ChannelName") or LocalPlayer.DisplayName
    local plat = platformKey or "YouTube"
    local catKey = (LocalPlayer:GetAttribute("StreamCategory") :: string?) or "Gaming"
    local catIcon = if catKey == "IRL" then "📱" elseif catKey == "JustChatting" then "🎙️" else "🎮"

    if isLocalStreaming then
        TweenService:Create(streamButton, TweenInfo.new(0.25), {
            BackgroundColor3 = Color3.fromRGB(231, 76, 60),
        }):Play()
        streamButton.Text = `⏹ Stop Stream ({plat})`
        chatHeader.Text = `  🔴 «{currentChannel}» LIVE [{plat}] [{catIcon} {catKey}]`
        chatHeader.TextColor3 = Color3.fromRGB(255, 120, 120)

        startCommentLoop()
    else
        TweenService:Create(streamButton, TweenInfo.new(0.25), {
            BackgroundColor3 = Color3.fromRGB(46, 204, 113),
        }):Play()
        streamButton.Text = "▶ Start Stream"
        chatHeader.Text = `  💬 «{currentChannel}» (Offline)`
        chatHeader.TextColor3 = Color3.fromRGB(220, 225, 235)
    end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_PlatformSelectGui">
				<Properties>
					<string name="Name">PlatformSelectGui</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local StreamConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("StreamConfig") :: ModuleScript)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local toggleStreamRemote = remotesFolder:WaitForChild("ToggleStream") :: RemoteEvent
local promptRobuxRemote = remotesFolder:WaitForChild("PromptRobuxPurchase") :: RemoteEvent
local lockPlatformRemote = remotesFolder:WaitForChild("LockPlatform") :: RemoteEvent
local promptPlatformSelectRemote = remotesFolder:WaitForChild("PromptPlatformSelect") :: RemoteEvent
local rebirthResultRemote = remotesFolder:WaitForChild("RebirthResult") :: RemoteEvent

-- ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PlatformSelectGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.DisplayOrder = 20
screenGui.Parent = PlayerGui

-- Backdrop
local backdrop = Instance.new("Frame")
backdrop.Name = "PlatformBackdrop"
backdrop.Size = UDim2.new(1, 0, 1, 0)
backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
backdrop.BackgroundTransparency = 0.55
backdrop.Visible = false
backdrop.ZIndex = 30
backdrop.Parent = screenGui

-- Window
local window = Instance.new("Frame")
window.Name = "PlatformWindow"
window.Size = UDim2.new(0, 560, 0, 520)
window.Position = UDim2.new(0.5, 0, 0.5, 0)
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
window.BorderSizePixel = 0
window.ZIndex = 31
window.Parent = backdrop

local winCorner = Instance.new("UICorner")
winCorner.CornerRadius = UDim.new(0, 16)
winCorner.Parent = window

local winStroke = Instance.new("UIStroke")
winStroke.Color = Color3.fromRGB(52, 152, 219)
winStroke.Thickness = 2
winStroke.Parent = window

-- Top Bar
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -70, 0, 32)
title.Position = UDim2.new(0, 20, 0, 14)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "📡 CHOOSE STREAM PLATFORMS"
title.ZIndex = 32
title.Parent = window

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 32, 0, 32)
closeBtn.Position = UDim2.new(1, -46, 0, 14)
closeBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 16
closeBtn.Text = "✕"
closeBtn.ZIndex = 32
closeBtn.Parent = window

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 8)
closeCorner.Parent = closeBtn

closeBtn.MouseButton1Click:Connect(function()
    backdrop.Visible = false
end)

-- 1. Mode Banner (Single platform free vs Dual platform with Robux)
local modeBanner = Instance.new("Frame")
modeBanner.Name = "ModeBanner"
modeBanner.Size = UDim2.new(1, -40, 0, 52)
modeBanner.Position = UDim2.new(0, 20, 0, 52)
modeBanner.BackgroundColor3 = Color3.fromRGB(28, 32, 48)
modeBanner.BorderSizePixel = 0
modeBanner.ZIndex = 32
modeBanner.Parent = window

local mbCorner = Instance.new("UICorner"); mbCorner.CornerRadius = UDim.new(0, 10); mbCorner.Parent = modeBanner
local mbStroke = Instance.new("UIStroke"); mbStroke.Color = Color3.fromRGB(60, 75, 110); mbStroke.Thickness = 1.2; mbStroke.Parent = modeBanner

local modeTitle = Instance.new("TextLabel")
modeTitle.Size = UDim2.new(1, -170, 0, 22)
modeTitle.Position = UDim2.new(0, 12, 0, 6)
modeTitle.BackgroundTransparency = 1
modeTitle.Font = Enum.Font.GothamBold
modeTitle.TextSize = 13
modeTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
modeTitle.TextXAlignment = Enum.TextXAlignment.Left
modeTitle.Text = "📡 Standard Mode: 1 Platform Only"
modeTitle.ZIndex = 33
modeTitle.Parent = modeBanner

local modeDesc = Instance.new("TextLabel")
modeDesc.Size = UDim2.new(1, -170, 0, 18)
modeDesc.Position = UDim2.new(0, 12, 0, 28)
modeDesc.BackgroundTransparency = 1
modeDesc.Font = Enum.Font.Gotham
modeDesc.TextSize = 11
modeDesc.TextColor3 = Color3.fromRGB(170, 180, 205)
modeDesc.TextXAlignment = Enum.TextXAlignment.Left
modeDesc.Text = "Unlock Split Dual-Stream to broadcast to 2 platforms at once!"
modeDesc.ZIndex = 33
modeDesc.Parent = modeBanner

local splitUnlockBtn = Instance.new("TextButton")
splitUnlockBtn.Name = "SplitUnlockBtn"
splitUnlockBtn.Size = UDim2.new(0, 150, 0, 36)
splitUnlockBtn.Position = UDim2.new(1, -158, 0.5, -18)
splitUnlockBtn.BackgroundColor3 = Color3.fromRGB(230, 140, 10)
splitUnlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
splitUnlockBtn.Font = Enum.Font.GothamBold
splitUnlockBtn.TextSize = 12
splitUnlockBtn.Text = "💎 49 R$ (Split Pass)"
splitUnlockBtn.ZIndex = 34
splitUnlockBtn.Parent = modeBanner
local suCorner = Instance.new("UICorner"); suCorner.CornerRadius = UDim.new(0, 8); suCorner.Parent = splitUnlockBtn
local suStroke = Instance.new("UIStroke"); suStroke.Color = Color3.fromRGB(255, 215, 0); suStroke.Thickness = 1.2; suStroke.Parent = splitUnlockBtn

splitUnlockBtn.MouseButton1Click:Connect(function()
    promptRobuxRemote:FireServer("MultiStreamLicense")
end)

local function syncWithLock(): boolean
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    if locked and locked ~= "" then
        selectedPlatforms = {}
        for plat in string.gmatch(locked, "[^+]+") do
            selectedPlatforms[plat] = true
        end
        return true
    end
    return false
end

local function updateModeBanner()
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    local isLocked = locked and locked ~= ""
    local hasSplit = LocalPlayer:GetAttribute("Owned_MultiStreamLicense") == true

    if isLocked then
        modeBanner.BackgroundColor3 = Color3.fromRGB(24, 30, 44)
        mbStroke.Color = Color3.fromRGB(52, 152, 219)
        modeTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
        modeTitle.Text = `🔒 CONTRACT LOCKED: {locked:gsub("+", " + ")}`
        modeDesc.Text = "Platform choice is LOCKED until Rebirth! Swapping platforms is disabled in this life."
        splitUnlockBtn.Visible = false
    elseif hasSplit then
        modeBanner.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
        mbStroke.Color = Color3.fromRGB(210, 80, 255)
        modeTitle.TextColor3 = Color3.fromRGB(255, 120, 255)
        modeTitle.Text = "⭐ SPLIT DUAL-STREAM ACTIVE (2 Platforms Max)"
        modeDesc.Text = "You can stream to any 2 platforms simultaneously (+85% Cash & +50% Subs)!"
        splitUnlockBtn.Visible = true
        splitUnlockBtn.BackgroundColor3 = Color3.fromRGB(30, 70, 40)
        splitUnlockBtn.Text = "✅ UNLOCKED"
        splitUnlockBtn.TextColor3 = Color3.fromRGB(100, 240, 120)
        suStroke.Color = Color3.fromRGB(46, 204, 113)
        splitUnlockBtn.Active = false
    else
        modeBanner.BackgroundColor3 = Color3.fromRGB(28, 32, 48)
        mbStroke.Color = Color3.fromRGB(60, 75, 110)
        modeTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
        modeTitle.Text = "📡 Standard Mode: 1 Platform Only"
        modeDesc.Text = "Unlock Split Dual-Stream to broadcast to 2 platforms at once!"
        splitUnlockBtn.Visible = true
        splitUnlockBtn.BackgroundColor3 = Color3.fromRGB(230, 140, 10)
        splitUnlockBtn.Text = "💎 49 R$ (Split Pass)"
        splitUnlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        suStroke.Color = Color3.fromRGB(255, 215, 0)
        splitUnlockBtn.Active = true
    end
end

LocalPlayer:GetAttributeChangedSignal("Owned_MultiStreamLicense"):Connect(updateModeBanner)

-- 2. Platform Selection State & Rows Container
local selectedPlatforms = { YouTube = true }

local platformsList = {
    { Id = "YouTube", Name = "YouTube Live", ColorHex = "#FF0000", Icon = "🔴", MoneyMult = "1.0x", HypeMult = "1.0x", Desc = "Balanced audience and revenue growth. Reliable starting platform." },
    { Id = "Twitch", Name = "Twitch", ColorHex = "#9146FF", Icon = "🟣", MoneyMult = "1.35x", HypeMult = "1.0x", Desc = "Generous live donation culture! +35% Money earnings per second." },
    { Id = "TikTok", Name = "TikTok Live", ColorHex = "#00F2FE", Icon = "🎵", MoneyMult = "1.0x", HypeMult = "1.60x", Desc = "Viral reach & rapid viewer spikes! +60% Subscriber gain per second." },
}

local cardsContainer = Instance.new("Frame")
cardsContainer.Name = "CardsContainer"
cardsContainer.Size = UDim2.new(1, -40, 0, 260)
cardsContainer.Position = UDim2.new(0, 20, 0, 114)
cardsContainer.BackgroundTransparency = 1
cardsContainer.ZIndex = 32
cardsContainer.Parent = window

local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 10)
layout.Parent = cardsContainer

local platformRowCards: { [string]: Frame } = {}
local platformSelectBtns: { [string]: TextButton } = {}
local platformClickAreas: { [string]: TextButton } = {}

-- 3. Dedicated Status Row for all platforms (Summary of current broadcast)
local summaryRow = Instance.new("Frame")
summaryRow.Name = "SummaryRow"
summaryRow.Size = UDim2.new(1, -40, 0, 40)
summaryRow.Position = UDim2.new(0, 20, 0, 385)
summaryRow.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
summaryRow.BorderSizePixel = 0
summaryRow.ZIndex = 32
summaryRow.Parent = window

local sumCorner = Instance.new("UICorner"); sumCorner.CornerRadius = UDim.new(0, 8); sumCorner.Parent = summaryRow
local sumStroke = Instance.new("UIStroke"); sumStroke.Color = Color3.fromRGB(46, 204, 113); sumStroke.Thickness = 1.2; sumStroke.Parent = summaryRow

local summaryLabel = Instance.new("TextLabel")
summaryLabel.Name = "SummaryLabel"
summaryLabel.Size = UDim2.new(1, -20, 1, 0)
summaryLabel.Position = UDim2.new(0, 10, 0, 0)
summaryLabel.BackgroundTransparency = 1
summaryLabel.Font = Enum.Font.GothamBold
summaryLabel.TextSize = 12
summaryLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
summaryLabel.TextXAlignment = Enum.TextXAlignment.Left
summaryLabel.ZIndex = 33
summaryLabel.Parent = summaryRow

local function getSelectedCount(): number
    local count = 0
    for _, isSel in selectedPlatforms do
        if isSel then count += 1 end
    end
    return count
end

local function updateSummaryRow()
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    local isLocked = locked and locked ~= ""

    local names = {}
    for _, p in platformsList do
        if selectedPlatforms[p.Id] then
            table.insert(names, `{p.Icon} {p.Name}`)
        end
    end

    local count = #names
    if isLocked then
        summaryLabel.Text = `🔒 Locked Contract: {table.concat(names, " + ")} (Perform Rebirth to choose another!)`
        summaryLabel.TextColor3 = Color3.fromRGB(130, 215, 255)
        sumStroke.Color = Color3.fromRGB(52, 152, 219)
    elseif count == 0 then
        summaryLabel.Text = "⚠️ No platform selected! Click a platform above to stream."
        summaryLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        sumStroke.Color = Color3.fromRGB(231, 76, 60)
    elseif count == 1 then
        summaryLabel.Text = `📊 Selected Platform: {names[1]} (Click Confirm & Lock below)`
        summaryLabel.TextColor3 = Color3.fromRGB(220, 240, 255)
        sumStroke.Color = Color3.fromRGB(52, 152, 219)
    else
        summaryLabel.Text = `⭐ SPLIT DUAL: {table.concat(names, " + ")} (+85% Cash & +50% Subs!)`
        summaryLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
        sumStroke.Color = Color3.fromRGB(255, 215, 0)
    end
end

local function refreshPlatformRows()
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    local isLocked = locked and locked ~= ""
    if isLocked then
        syncWithLock()
    end

    for _, p in platformsList do
        local card = platformRowCards[p.Id]
        local btn = platformSelectBtns[p.Id]
        local clickArea = platformClickAreas[p.Id]
        if card and btn then
            local isSel = selectedPlatforms[p.Id] == true
            local stroke = card:FindFirstChildOfClass("UIStroke")

            if isLocked then
                if clickArea then clickArea.Active = false end
                btn.Active = false
                btn.AutoButtonColor = false

                if isSel then
                    card.BackgroundColor3 = Color3.fromRGB(25, 38, 48)
                    if stroke then stroke.Color = Color3.fromRGB(46, 204, 113); stroke.Thickness = 2 end
                    btn.BackgroundColor3 = Color3.fromRGB(35, 75, 55)
                    btn.Text = "✔ ACTIVE CONTRACT"
                    btn.TextColor3 = Color3.fromRGB(100, 240, 130)
                else
                    card.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
                    if stroke then stroke.Color = Color3.fromRGB(35, 40, 50); stroke.Thickness = 1 end
                    btn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
                    btn.Text = "🔒 Locked"
                    btn.TextColor3 = Color3.fromRGB(100, 110, 125)
                end
            else
                if clickArea then clickArea.Active = true end
                btn.Active = true
                btn.AutoButtonColor = true

                if isSel then
                    card.BackgroundColor3 = Color3.fromRGB(30, 42, 58)
                    if stroke then stroke.Color = Color3.fromRGB(46, 204, 113); stroke.Thickness = 2 end
                    btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                    btn.Text = "✔ SELECTED"
                    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    card.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
                    if stroke then stroke.Color = Color3.fromRGB(50, 60, 80); stroke.Thickness = 1 end
                    btn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
                    btn.Text = "Select"
                    btn.TextColor3 = Color3.fromRGB(180, 195, 220)
                end
            end
        end
    end
    updateSummaryRow()
end

local function togglePlatform(platId: string)
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    if locked and locked ~= "" then
        -- Platform choice is locked until Rebirth! Swapping is blocked.
        return
    end

    local hasSplit = LocalPlayer:GetAttribute("Owned_MultiStreamLicense") == true

    if not hasSplit then
        -- Without Robux Split Pass: strictly 1 platform only!
        selectedPlatforms = { [platId] = true }
    else
        -- With Robux Split Pass: can pick up to 2 platforms!
        if selectedPlatforms[platId] then
            -- Can only unselect if there is another one selected
            if getSelectedCount() > 1 then
                selectedPlatforms[platId] = nil
            end
        else
            if getSelectedCount() < 2 then
                selectedPlatforms[platId] = true
            else
                -- Replace the first one to keep strictly 2
                for k in selectedPlatforms do
                    selectedPlatforms[k] = nil
                    break
                end
                selectedPlatforms[platId] = true
            end
        end
    end

    refreshPlatformRows()
end

-- Render Individual Platform Rows
for idx, p in platformsList do
    local card = Instance.new("Frame")
    card.Name = `Row_{p.Id}`
    card.LayoutOrder = idx
    card.Size = UDim2.new(1, 0, 0, 74)
    card.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
    card.BorderSizePixel = 0
    card.ZIndex = 33
    card.Parent = cardsContainer

    local cCorner = Instance.new("UICorner"); cCorner.CornerRadius = UDim.new(0, 10); cCorner.Parent = card
    local cStroke = Instance.new("UIStroke"); cStroke.Color = Color3.fromRGB(50, 60, 80); cStroke.Thickness = 1; cStroke.Parent = card

    -- Icon + Name Badge
    local nameBadge = Instance.new("TextLabel")
    nameBadge.Size = UDim2.new(0, 135, 0, 26)
    nameBadge.Position = UDim2.new(0, 12, 0, 10)
    nameBadge.BackgroundColor3 = Color3.fromHex(p.ColorHex)
    nameBadge.Text = `{p.Icon} {p.Name}`
    nameBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameBadge.Font = Enum.Font.GothamBold
    nameBadge.TextSize = 12
    nameBadge.ZIndex = 34
    nameBadge.Parent = card
    local nbCorner = Instance.new("UICorner"); nbCorner.CornerRadius = UDim.new(0, 6); nbCorner.Parent = nameBadge

    -- Stats label
    local stats = Instance.new("TextLabel")
    stats.Size = UDim2.new(1, -275, 0, 26)
    stats.Position = UDim2.new(0, 155, 0, 10)
    stats.BackgroundTransparency = 1
    stats.Font = Enum.Font.GothamBold
    stats.TextSize = 12
    stats.TextColor3 = Color3.fromRGB(255, 215, 0)
    stats.TextXAlignment = Enum.TextXAlignment.Left
    stats.Text = `💵 {p.MoneyMult} Cash  |  ⭐ {p.HypeMult} Subs`
    stats.ZIndex = 34
    stats.Parent = card

    -- Description
    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -145, 0, 22)
    desc.Position = UDim2.new(0, 12, 0, 42)
    desc.BackgroundTransparency = 1
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 11
    desc.TextColor3 = Color3.fromRGB(165, 175, 195)
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Text = p.Desc
    desc.ZIndex = 34
    desc.Parent = card

    -- Select Toggle Button
    local selBtn = Instance.new("TextButton")
    selBtn.Name = "SelectBtn"
    selBtn.Size = UDim2.new(0, 105, 0, 38)
    selBtn.Position = UDim2.new(1, -115, 0.5, -19)
    selBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
    selBtn.TextColor3 = Color3.fromRGB(180, 195, 220)
    selBtn.Font = Enum.Font.GothamBold
    selBtn.TextSize = 12
    selBtn.Text = "Select"
    selBtn.ZIndex = 35
    selBtn.Parent = card
    local sbCorner = Instance.new("UICorner"); sbCorner.CornerRadius = UDim.new(0, 8); sbCorner.Parent = selBtn

    selBtn.MouseButton1Click:Connect(function()
        togglePlatform(p.Id)
    end)

    -- Also clicking card row toggles
    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, -120, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.ZIndex = 34
    clickArea.Parent = card
    clickArea.MouseButton1Click:Connect(function()
        togglePlatform(p.Id)
    end)

    platformRowCards[p.Id] = card
    platformSelectBtns[p.Id] = selBtn
    platformClickAreas[p.Id] = clickArea
end

-- 4. Confirm & Lock Button
local launchBtn = Instance.new("TextButton")
launchBtn.Name = "LaunchStreamBtn"
launchBtn.Size = UDim2.new(1, -40, 0, 48)
launchBtn.Position = UDim2.new(0, 20, 1, -62)
launchBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
launchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
launchBtn.Font = Enum.Font.GothamBlack
launchBtn.TextSize = 15
launchBtn.Text = "🔒 CONFIRM & LOCK PLATFORM (UNTIL REBIRTH)"
launchBtn.ZIndex = 32
launchBtn.Parent = window

local lCorner = Instance.new("UICorner"); lCorner.CornerRadius = UDim.new(0, 10); lCorner.Parent = launchBtn

local function updateLockState()
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    if locked and locked ~= "" then
        launchBtn.BackgroundColor3 = Color3.fromRGB(55, 65, 80)
        launchBtn.Text = `🔒 CONTRACT ACTIVE: {locked:gsub("+", " + ")} (REBIRTH TO SWITCH)`
        launchBtn.TextColor3 = Color3.fromRGB(180, 190, 210)
        launchBtn.AutoButtonColor = false
    else
        launchBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        launchBtn.Text = "🔒 CONFIRM & LOCK PLATFORM (UNTIL REBIRTH)"
        launchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        launchBtn.AutoButtonColor = true
    end
end

launchBtn.MouseButton1Click:Connect(function()
    local existingLock = LocalPlayer:GetAttribute("LockedPlatform")
    if existingLock and existingLock ~= "" then
        backdrop.Visible = false
        return
    end

    local selectedList = {}
    for _, p in platformsList do
        if selectedPlatforms[p.Id] then
            table.insert(selectedList, p.Id)
        end
    end

    if #selectedList == 0 then
        table.insert(selectedList, "YouTube")
    end

    local platformArg = table.concat(selectedList, "+")
    lockPlatformRemote:FireServer(platformArg)
    backdrop.Visible = false
end)

LocalPlayer:GetAttributeChangedSignal("LockedPlatform"):Connect(function()
    syncWithLock()
    updateModeBanner()
    refreshPlatformRows()
    updateLockState()
end)

updateModeBanner()
refreshPlatformRows()
updateLockState()

LocalPlayer:GetAttributeChangedSignal("Owned_MultiStreamLicense"):Connect(function()
    updateModeBanner()
    local hasSplit = LocalPlayer:GetAttribute("Owned_MultiStreamLicense") == true
    if not hasSplit and getSelectedCount() > 1 then
        for k in selectedPlatforms do
            selectedPlatforms = { [k] = true }
            break
        end
        refreshPlatformRows()
    end
end)

--------------------------------------------------------------------------------
-- Open Menu Listener & Global Function
--------------------------------------------------------------------------------
local function openMenu(isRebirth: boolean?)
    local locked = LocalPlayer:GetAttribute("LockedPlatform")
    if isRebirth or not locked or locked == "" then
        if not selectedPlatforms or not next(selectedPlatforms) then
            selectedPlatforms = { YouTube = true }
        end
    else
        syncWithLock()
    end
    updateModeBanner()
    refreshPlatformRows()
    updateLockState()
    if isRebirth then
        modeTitle.Text = "🎉 REBIRTH COMPLETE! CHOOSE NEW CONTRACT"
        modeTitle.TextColor3 = Color3.fromRGB(46, 204, 113)
        modeDesc.Text = "Pick your streaming platform for your new rebirth era (+50% permanent boost active)!"
    end
    backdrop.Visible = true
end

_G.OpenPlatformSelect = openMenu

promptPlatformSelectRemote.OnClientEvent:Connect(function(isRebirth: boolean?)
    openMenu(isRebirth)
end)

local openSelectRemote = remotesFolder:FindFirstChild("OpenPlatformSelect") :: RemoteEvent?
if openSelectRemote then
    openSelectRemote.OnClientEvent:Connect(function()
        openMenu(false)
    end)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_StreamEventGui">
				<Properties>
					<string name="Name">StreamEventGui</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local streamPromptRemote = remotesFolder:WaitForChild("StreamPromptEvent") :: RemoteEvent
local submitChoiceRemote = remotesFolder:WaitForChild("SubmitStreamChoice") :: RemoteEvent
local choiceResultRemote = remotesFolder:WaitForChild("StreamChoiceResult") :: RemoteEvent

-- ScreenGui for Interactive Stream Prompts
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StreamEventGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

-- Event Card (Centered at top)
local eventCard = Instance.new("Frame")
eventCard.Name = "EventCard"
eventCard.Size = UDim2.new(0, 440, 0, 260)
eventCard.Position = UDim2.new(0.5, -220, 0.12, 0)
eventCard.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
eventCard.BorderSizePixel = 0
eventCard.Visible = false
eventCard.ZIndex = 40
eventCard.Parent = screenGui

local cardCorner = Instance.new("UICorner")
cardCorner.CornerRadius = UDim.new(0, 14)
cardCorner.Parent = eventCard

local cardStroke = Instance.new("UIStroke")
cardStroke.Color = Color3.fromRGB(255, 170, 0)
cardStroke.Thickness = 2
cardStroke.Parent = eventCard

-- Title
local titleLabel = Instance.new("TextLabel")
titleLabel.Name = "TitleLabel"
titleLabel.Size = UDim2.new(1, -20, 0, 32)
titleLabel.Position = UDim2.new(0, 10, 0, 10)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 17
titleLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
titleLabel.ZIndex = 41
titleLabel.Parent = eventCard

-- Situation description
local situationLabel = Instance.new("TextLabel")
situationLabel.Name = "SituationLabel"
situationLabel.Size = UDim2.new(1, -24, 0, 44)
situationLabel.Position = UDim2.new(0, 12, 0, 42)
situationLabel.BackgroundTransparency = 1
situationLabel.Font = Enum.Font.Gotham
situationLabel.TextSize = 13
situationLabel.TextColor3 = Color3.fromRGB(230, 235, 245)
situationLabel.TextWrapped = true
situationLabel.ZIndex = 41
situationLabel.Parent = eventCard

-- Timer Progress Bar
local timerBarBg = Instance.new("Frame")
timerBarBg.Name = "TimerBarBg"
timerBarBg.Size = UDim2.new(1, -24, 0, 6)
timerBarBg.Position = UDim2.new(0, 12, 0, 90)
timerBarBg.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
timerBarBg.BorderSizePixel = 0
timerBarBg.ZIndex = 41
timerBarBg.Parent = eventCard

local timerCorner = Instance.new("UICorner")
timerCorner.CornerRadius = UDim.new(1, 0)
timerCorner.Parent = timerBarBg

local timerFill = Instance.new("Frame")
timerFill.Name = "TimerFill"
timerFill.Size = UDim2.new(1, 0, 1, 0)
timerFill.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
timerFill.BorderSizePixel = 0
timerFill.ZIndex = 42
timerFill.Parent = timerBarBg

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(1, 0)
fillCorner.Parent = timerFill

-- Buttons Container
local choicesContainer = Instance.new("Frame")
choicesContainer.Name = "ChoicesContainer"
choicesContainer.Size = UDim2.new(1, -24, 0, 140)
choicesContainer.Position = UDim2.new(0, 12, 0, 105)
choicesContainer.BackgroundTransparency = 1
choicesContainer.ZIndex = 41
choicesContainer.Parent = eventCard

local choicesLayout = Instance.new("UIListLayout")
choicesLayout.SortOrder = Enum.SortOrder.LayoutOrder
choicesLayout.Padding = UDim.new(0, 8)
choicesLayout.Parent = choicesContainer

local currentEventId = ""
local timerTween: Tween? = nil

local function showFloatingOutcome(text: string, isPositive: boolean)
    local floatLabel = Instance.new("TextLabel")
    floatLabel.Size = UDim2.new(0, 300, 0, 45)
    floatLabel.Position = UDim2.new(0.5, -150, 0.45, 0)
    floatLabel.BackgroundColor3 = if isPositive then Color3.fromRGB(30, 45, 30) else Color3.fromRGB(50, 25, 25)
    floatLabel.BackgroundTransparency = 0.2
    floatLabel.TextColor3 = if isPositive then Color3.fromRGB(46, 204, 113) else Color3.fromRGB(231, 76, 60)
    floatLabel.Font = Enum.Font.GothamBold
    floatLabel.TextSize = 16
    floatLabel.Text = text
    floatLabel.ZIndex = 50
    floatLabel.Parent = screenGui

    local stroke = Instance.new("UIStroke")
    stroke.Color = if isPositive then Color3.fromRGB(46, 204, 113) else Color3.fromRGB(231, 76, 60)
    stroke.Thickness = 2
    stroke.Parent = floatLabel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = floatLabel

    TweenService:Create(floatLabel, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -150, 0.35, 0),
        BackgroundTransparency = 1,
        TextTransparency = 1,
    }):Play()

    task.delay(2, function()
        floatLabel:Destroy()
    end)
end

-- Handle receiving prompt from server
streamPromptRemote.OnClientEvent:Connect(function(data: any)
    currentEventId = data.Id
    titleLabel.Text = data.Title
    situationLabel.Text = data.Situation

    -- Clear old buttons
    for _, ch in choicesContainer:GetChildren() do
        if ch:IsA("TextButton") then
            ch:Destroy()
        end
    end

    -- Create choice buttons
    for idx, choice in data.Choices do
        local btn = Instance.new("TextButton")
        btn.Name = `Choice_{choice.Id}`
        btn.LayoutOrder = idx
        btn.Size = UDim2.new(1, 0, 0, 38)
        btn.BackgroundColor3 = Color3.fromRGB(35, 40, 52)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 13
        btn.Text = choice.Text
        btn.ZIndex = 43
        btn.Parent = choicesContainer

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = btn

        local btnStroke = Instance.new("UIStroke")
        btnStroke.Color = Color3.fromRGB(60, 68, 85)
        btnStroke.Thickness = 1
        btnStroke.Parent = btn

        btn.MouseButton1Click:Connect(function()
            eventCard.Visible = false
            if timerTween then timerTween:Cancel() end
            submitChoiceRemote:FireServer(currentEventId, choice.Id)
        end)
    end

    -- Resize card according to number of choices
    eventCard.Size = UDim2.new(0, 440, 0, 120 + (#data.Choices * 46))
    choicesContainer.Size = UDim2.new(1, -24, 0, #data.Choices * 46)

    timerFill.Size = UDim2.new(1, 0, 1, 0)
    eventCard.Visible = true

    -- Animate countdown bar
    if timerTween then timerTween:Cancel() end
    timerTween = TweenService:Create(timerFill, TweenInfo.new(data.TimeoutSeconds, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 1, 0),
    })
    timerTween:Play()

    task.delay(data.TimeoutSeconds, function()
        if eventCard.Visible and currentEventId == data.Id then
            eventCard.Visible = false
        end
    end)
end)

-- Handle choice result
choiceResultRemote.OnClientEvent:Connect(function(res: any)
    local sign = if res.HypeDelta >= 0 then "+" else ""
    local hypeStr = `{sign}{res.HypeDelta} Subs`
    local moneyStr = if res.MoneyDelta > 0 then ` | +${res.MoneyDelta}` else ""
    local outcomeText = `{res.Message}\n({hypeStr}{moneyStr})`

    showFloatingOutcome(outcomeText, res.Success)
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_ShopGui">
				<Properties>
					<string name="Name">ShopGui</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local ShopConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShopConfig") :: ModuleScript)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local buyItemRemote = remotesFolder:WaitForChild("BuyShopItem") :: RemoteEvent
local shopResultRemote = remotesFolder:WaitForChild("ShopItemPurchased") :: RemoteEvent

-- Create Shop ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ShopGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

-- Floating Quick Shop Button on screen
local openShopBtn = Instance.new("TextButton")
openShopBtn.Name = "OpenShopButton"
openShopBtn.Size = UDim2.new(0, 110, 0, 44)
openShopBtn.Position = UDim2.new(1, -125, 0.5, -22)
openShopBtn.BackgroundColor3 = Color3.fromRGB(41, 128, 185)
openShopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
openShopBtn.Font = Enum.Font.GothamBold
openShopBtn.TextSize = 15
openShopBtn.Text = "🛒 Shop"
openShopBtn.Parent = screenGui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 10)
btnCorner.Parent = openShopBtn

local btnStroke = Instance.new("UIStroke")
btnStroke.Color = Color3.fromRGB(52, 152, 219)
btnStroke.Thickness = 1.5
btnStroke.Parent = openShopBtn

-- Modal Backdrop
local modalBackdrop = Instance.new("Frame")
modalBackdrop.Name = "ShopBackdrop"
modalBackdrop.Size = UDim2.new(1, 0, 1, 0)
modalBackdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
modalBackdrop.BackgroundTransparency = 0.55
modalBackdrop.Visible = false
modalBackdrop.ZIndex = 20
modalBackdrop.Parent = screenGui

-- Main Shop Window
local shopWindow = Instance.new("Frame")
shopWindow.Name = "ShopWindow"
shopWindow.Size = UDim2.new(0, 520, 0, 460)
shopWindow.Position = UDim2.new(0.5, -260, 0.5, -230)
shopWindow.BackgroundColor3 = Color3.fromRGB(22, 25, 34)
shopWindow.BorderSizePixel = 0
shopWindow.ZIndex = 21
shopWindow.Parent = modalBackdrop

local windowCorner = Instance.new("UICorner")
windowCorner.CornerRadius = UDim.new(0, 14)
windowCorner.Parent = shopWindow

local windowStroke = Instance.new("UIStroke")
windowStroke.Color = Color3.fromRGB(52, 152, 219)
windowStroke.Thickness = 1.8
windowStroke.Parent = shopWindow

-- Title Header
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -60, 0, 35)
titleLabel.Position = UDim2.new(0, 20, 0, 10)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 20
titleLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Text = "🛒 STREAMER GEAR & TECH SHOP"
titleLabel.ZIndex = 22
titleLabel.Parent = shopWindow

local subtitleLabel = Instance.new("TextLabel")
subtitleLabel.Size = UDim2.new(1, -60, 0, 20)
subtitleLabel.Position = UDim2.new(0, 20, 0, 42)
subtitleLabel.BackgroundTransparency = 1
subtitleLabel.Font = Enum.Font.Gotham
subtitleLabel.TextSize = 13
subtitleLabel.TextColor3 = Color3.fromRGB(170, 175, 190)
subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
subtitleLabel.Text = "Equip better hardware to boost your Money and Subscribers per second!"
subtitleLabel.ZIndex = 22
subtitleLabel.Parent = shopWindow

-- Close Button
local closeBtn = Instance.new("TextButton")
closeBtn.Name = "CloseButton"
closeBtn.Size = UDim2.new(0, 32, 0, 32)
closeBtn.Position = UDim2.new(1, -44, 0, 12)
closeBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 16
closeBtn.Text = "✕"
closeBtn.ZIndex = 22
closeBtn.Parent = shopWindow

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 8)
closeCorner.Parent = closeBtn

-- Scrolling Items List
local scrollList = Instance.new("ScrollingFrame")
scrollList.Name = "ItemList"
scrollList.Size = UDim2.new(1, -24, 1, -85)
scrollList.Position = UDim2.new(0, 12, 0, 72)
scrollList.BackgroundTransparency = 1
scrollList.BorderSizePixel = 0
scrollList.ScrollBarThickness = 5
scrollList.AutomaticCanvasSize = Enum.AutomaticSize.Y
scrollList.ZIndex = 22
scrollList.Parent = shopWindow

local listLayout = Instance.new("UIListLayout")
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 8)
listLayout.Parent = scrollList

local itemButtons: { [string]: TextButton } = {}

local function refreshShopItems()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local moneyVal = leaderstats and leaderstats:FindFirstChild("Money") :: IntValue?
    local currentMoney = moneyVal and moneyVal.Value or 0

    -- Sort items by price
    local sortedItems = {}
    for _, item in ShopConfig do
        table.insert(sortedItems, item)
    end
    table.sort(sortedItems, function(a, b) return a.Price < b.Price end)

    for order, item in sortedItems do
        local isOwned = LocalPlayer:GetAttribute("Owned_" .. item.Id) == true
        local btn = itemButtons[item.Id]

        if not btn then
            local card = Instance.new("Frame")
            card.Name = `Card_{item.Id}`
            card.LayoutOrder = order
            card.Size = UDim2.new(1, -8, 0, 64)
            card.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
            card.ZIndex = 23
            card.Parent = scrollList

            local cardCorner = Instance.new("UICorner")
            cardCorner.CornerRadius = UDim.new(0, 10)
            cardCorner.Parent = card

            -- Icon
            local icon = Instance.new("TextLabel")
            icon.Size = UDim2.new(0, 48, 1, 0)
            icon.BackgroundTransparency = 1
            icon.Font = Enum.Font.GothamBold
            icon.TextSize = 24
            icon.Text = item.IconText
            icon.ZIndex = 24
            icon.Parent = card

            -- Info
            local name = Instance.new("TextLabel")
            name.Size = UDim2.new(1, -190, 0, 24)
            name.Position = UDim2.new(0, 52, 0, 8)
            name.BackgroundTransparency = 1
            name.Font = Enum.Font.GothamBold
            name.TextSize = 14
            name.TextColor3 = Color3.fromRGB(255, 255, 255)
            name.TextXAlignment = Enum.TextXAlignment.Left
            name.Text = item.Name
            name.ZIndex = 24
            name.Parent = card

            local desc = Instance.new("TextLabel")
            desc.Size = UDim2.new(1, -190, 0, 20)
            desc.Position = UDim2.new(0, 52, 0, 32)
            desc.BackgroundTransparency = 1
            desc.Font = Enum.Font.Gotham
            desc.TextSize = 12
            desc.TextColor3 = Color3.fromRGB(46, 204, 113)
            desc.TextXAlignment = Enum.TextXAlignment.Left
            desc.Text = item.Description
            desc.ZIndex = 24
            desc.Parent = card

            -- Buy Button
            local buyBtn = Instance.new("TextButton")
            buyBtn.Name = "BuyButton"
            buyBtn.Size = UDim2.new(0, 120, 0, 40)
            buyBtn.Position = UDim2.new(1, -130, 0.5, -20)
            buyBtn.Font = Enum.Font.GothamBold
            buyBtn.TextSize = 13
            buyBtn.ZIndex = 24
            buyBtn.Parent = card

            local buyCorner = Instance.new("UICorner")
            buyCorner.CornerRadius = UDim.new(0, 8)
            buyCorner.Parent = buyBtn

            buyBtn.MouseButton1Click:Connect(function()
                if not (LocalPlayer:GetAttribute("Owned_" .. item.Id) == true) then
                    buyItemRemote:FireServer(item.Id)
                end
            end)

            itemButtons[item.Id] = buyBtn
            btn = buyBtn
        end

        if isOwned then
            btn.Text = "✔ OWNED"
            btn.BackgroundColor3 = Color3.fromRGB(70, 75, 85)
            btn.TextColor3 = Color3.fromRGB(160, 165, 175)
            btn.AutoButtonColor = false
        elseif currentMoney >= item.Price then
            btn.Text = `Buy: ${item.Price}`
            btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.AutoButtonColor = true
        else
            btn.Text = `🔒 ${item.Price}`
            btn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
            btn.TextColor3 = Color3.fromRGB(220, 120, 120)
            btn.AutoButtonColor = true
        end
    end
end

local function openShop()
    refreshShopItems()
    modalBackdrop.Visible = true
end

local function closeShop()
    modalBackdrop.Visible = false
end

openShopBtn.MouseButton1Click:Connect(openShop)
closeBtn.MouseButton1Click:Connect(closeShop)

shopResultRemote.OnClientEvent:Connect(function(itemId: string, success: boolean, message: string)
    refreshShopItems()
end)

LocalPlayer.AttributeChanged:Connect(function(attr)
    if attr:sub(1, 6) == "Owned_" then
        refreshShopItems()
    end
end)

-- Physical In-World Counter ProximityPrompts
local ProximityPromptService = game:GetService("ProximityPromptService")
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
    if player == LocalPlayer then
        if prompt.Name == "TechPrompt" or prompt.Name == "GroceryPrompt" then
            openShop()
        end
    end
end)

]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_VehicleGui">
				<Properties>
					<string name="Name">VehicleGui</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
local flipCarRemote = remotesFolder:WaitForChild("FlipCar") :: RemoteEvent

-- ScreenGui for Driving HUD
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VehicleGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

-- Main Dashboard Container (Bottom Center)
local dashFrame = Instance.new("Frame")
dashFrame.Name = "DashboardFrame"
dashFrame.Size = UDim2.new(0, 360, 0, 75)
dashFrame.Position = UDim2.new(0.5, -180, 1, 100) -- Hidden initially
dashFrame.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
dashFrame.BackgroundTransparency = 0.2
dashFrame.BorderSizePixel = 0
dashFrame.Parent = screenGui

local dashCorner = Instance.new("UICorner")
dashCorner.CornerRadius = UDim.new(0, 14)
dashCorner.Parent = dashFrame

local dashStroke = Instance.new("UIStroke")
dashStroke.Color = Color3.fromRGB(231, 76, 60)
dashStroke.Thickness = 2
dashStroke.Parent = dashFrame

-- Speedometer Label
local speedLabel = Instance.new("TextLabel")
speedLabel.Name = "SpeedLabel"
speedLabel.Size = UDim2.new(0, 130, 0, 42)
speedLabel.Position = UDim2.new(0, 15, 0, 8)
speedLabel.BackgroundTransparency = 1
speedLabel.Font = Enum.Font.GothamBold
speedLabel.TextSize = 28
speedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.Text = "0 <font size=\"14\" color=\"#aaaaaa\">KM/H</font>"
speedLabel.RichText = true
speedLabel.Parent = dashFrame

-- Vehicle Name / Status
local statusLabel = Instance.new("TextLabel")
statusLabel.Name = "StatusLabel"
statusLabel.Size = UDim2.new(0, 130, 0, 18)
statusLabel.Position = UDim2.new(0, 15, 0, 48)
statusLabel.BackgroundTransparency = 1
statusLabel.Font = Enum.Font.GothamMedium
statusLabel.TextSize = 12
statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.Text = "🚗 STARTER SEDAN"
statusLabel.Parent = dashFrame

-- Controls Reminder Text
local controlsLabel = Instance.new("TextLabel")
controlsLabel.Name = "ControlsLabel"
controlsLabel.Size = UDim2.new(0, 195, 0, 58)
controlsLabel.Position = UDim2.new(1, -205, 0, 8)
controlsLabel.BackgroundTransparency = 1
controlsLabel.Font = Enum.Font.Gotham
controlsLabel.TextSize = 11
controlsLabel.TextColor3 = Color3.fromRGB(210, 215, 230)
controlsLabel.TextXAlignment = Enum.TextXAlignment.Right
controlsLabel.TextYAlignment = Enum.TextYAlignment.Center
controlsLabel.TextWrapped = true
controlsLabel.Text = "<b>[W/S]</b> Drive / Reverse\n<b>[A/D]</b> Steer  |  <b>[F]</b> Flip Car\n<b>[Space / Jump]</b> Exit Vehicle"
controlsLabel.RichText = true
controlsLabel.Parent = dashFrame

local currentSeat: VehicleSeat? = nil
local speedConn: RBXScriptConnection? = nil

local function showDashboard()
    TweenService:Create(dashFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -180, 1, -95),
    }):Play()
end

local function hideDashboard()
    TweenService:Create(dashFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, -180, 1, 100),
    }):Play()
end

local function onSeated(active: boolean, seatPart: Instance?)
    if active and seatPart and seatPart:IsA("VehicleSeat") then
        currentSeat = seatPart
        showDashboard()

        if speedConn then speedConn:Disconnect() end
        speedConn = RunService.RenderStepped:Connect(function()
            if not currentSeat or not currentSeat.Parent then return end
            local chassis = currentSeat.Parent:FindFirstChild("CarChassis") :: BasePart?
            if chassis then
                local speedStudsPerSec = chassis.AssemblyLinearVelocity.Magnitude
                -- 1 stud ≈ 0.28 meters -> speed * 0.28 * 3.6 ≈ speed * 1.0 km/h
                local kmh = math.floor(speedStudsPerSec * 1.05)
                local colorHex = if kmh > 50 then "#FF5555" elseif kmh > 25 then "#FFAA00" else "#FFFFFF"
                speedLabel.Text = `<font color="{colorHex}">{kmh}</font> <font size="14" color="#aaaaaa">KM/H</font>`
            end
        end)
    else
        currentSeat = nil
        if speedConn then
            speedConn:Disconnect()
            speedConn = nil
        end
        hideDashboard()
    end
end

local function bindCharacter(char: Model)
    local humanoid = char:WaitForChild("Humanoid") :: Humanoid
    humanoid.Seated:Connect(onSeated)
end

if LocalPlayer.Character then
    bindCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(bindCharacter)

-- Flip Car Keybind (F)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F and currentSeat ~= nil then
        flipCarRemote:FireServer()
    end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX_CityWaypoints">
				<Properties>
					<string name="Name">CityWaypoints</string>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CityWaypointsGui"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

type WaypointData = {
    Name: string,
    Icon: string,
    Color: Color3,
    GetPosition: () -> Vector3?,
}

local waypoints: { WaypointData } = {
    {
        Name = "My Studio",
        Icon = "🏠",
        Color = Color3.fromRGB(52, 152, 219),
        GetPosition = function() return Vector3.new(0, 6, -62) end,
    },
    {
        Name = "Starter Car",
        Icon = "🚗",
        Color = Color3.fromRGB(231, 76, 60),
        GetPosition = function()
            local car = workspace:FindFirstChild("StarterCar", true) :: Model?
            local chassis = car and car:FindFirstChild("CarChassis") :: BasePart?
            return chassis and (chassis.Position + Vector3.new(0, 3, 0))
        end,
    },
    {
        Name = "CyberByte Tech",
        Icon = "💻",
        Color = Color3.fromRGB(0, 242, 254),
        GetPosition = function() return Vector3.new(46, 7, 40) end,
    },
    {
        Name = "Burger & Snacks",
        Icon = "🍔",
        Color = Color3.fromRGB(243, 156, 18),
        GetPosition = function() return Vector3.new(-46, 7, 40) end,
    },
    {
        Name = "Wall of Fame",
        Icon = "🏆",
        Color = Color3.fromRGB(255, 215, 0),
        GetPosition = function() return Vector3.new(-46, 12, 130) end,
    },
}

-- Create Screen Markers
local markerFrames: { [string]: Frame } = {}

for _, wp in waypoints do
    local frame = Instance.new("Frame")
    frame.Name = `Marker_{wp.Name}`
    frame.Size = UDim2.new(0, 130, 0, 26)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = wp.Color
    stroke.Thickness = 1.5
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Text = `{wp.Icon} {wp.Name}`
    label.Parent = frame

    markerFrames[wp.Name] = frame
end

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local char = LocalPlayer.Character
    local myPos = char and char:FindFirstChild("HumanoidRootPart") and (char.HumanoidRootPart :: BasePart).Position

    for _, wp in waypoints do
        local targetPos = wp.GetPosition()
        local frame = markerFrames[wp.Name]
        if not targetPos or not frame then
            if frame then frame.Visible = false end
            continue
        end

        local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
        local dist = if myPos then math.floor((targetPos - myPos).Magnitude) else 0

        -- Show waypoint if on screen and further than 14 studs
        if onScreen and dist > 14 and screenPos.Z > 0 then
            frame.Visible = true
            frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y - 20)
            local label = frame:FindFirstChild("Label") :: TextLabel?
            if label then
                label.Text = `{wp.Icon} {wp.Name} ({dist}m)`
            end
        else
            frame.Visible = false
        end
    end
end)
]]></ProtectedString>
				</Properties>
