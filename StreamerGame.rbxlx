	nicknameBoxCorner.Parent = nicknameBox

	setupError = Instance.new("TextLabel")
	setupError.Size = UDim2.new(1, 0, 0, 20)
	setupError.Position = UDim2.new(0, 0, 0, 144)
	setupError.BackgroundTransparency = 1
