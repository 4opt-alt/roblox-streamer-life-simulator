    local games = LocalPlayer:GetAttribute("GamesOwnedCount") or 0
    local gear = LocalPlayer:GetAttribute("GearOwnedCount") or 0
    setupLabel.Text = `⭐ Setup: {rank} ({games} games, {gear} gear)`
end

