			<Item class="ModuleScript" referent="RBX_StreamConfig">
				<Properties>
					<string name="Name">StreamConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict

export type PlatformInfo = {
    Id: string,
    Name: string,
    ColorHex: string,
    MoneyMultiplier: number,
    HypeMultiplier: number,
    Description: string,
    RequiresLicense: boolean,
    LicensePrice: number,
}

export type CategoryInfo = {
    Id: string,
    Name: string,
    Device: string,
    Description: string,
    Icon: string,
    ColorHex: string,
    MoneyMultiplier: number,
    HypeMultiplier: number,
    RequiresPC: boolean,
}

export type ConfigType = {
    IncomeIntervalSeconds: number,
    StarterMoney: number,
    StarterHype: number,
    BaseDonationChance: number,
    BaseSubChance: number,
    MaxEnergy: number,
    EnergyDrainSeconds: number,
    EnergyDrainPerSecond: number?,
    EnergyRestRecoverySeconds: number?,
    EventCycleDurationSeconds: number,
    EventBoostDurationSeconds: number,
    EventMoneyMultiplier: number,
    CommentIntervalMin: number,
    CommentIntervalMax: number,
    MaxChatHistory: number,
    MinChannelNameLength: number,
    MaxChannelNameLength: number,
    Platforms: { [string]: PlatformInfo },
    Categories: { [string]: CategoryInfo },
    ViewerComments: { string },
    IRLComments: { string }?,
    GamingComments: { string }?,
    JustChattingComments: { string }?,
    LowEnergyComments: { string },
    NoGameComments: { string },
    ProComments: { string },
    ViewerNames: { string },
    Rebirth: any?,
}

local StreamConfig: ConfigType = {
    -- Streamer progression economy
    IncomeIntervalSeconds = 1,
    StarterMoney = 15,          -- Starting pocket change: $15
    StarterHype = 0,            -- 0 Subscribers at start
    BaseDonationChance = 0.90,  -- 90% chance to earn money each second
    BaseSubChance = 0.95,       -- 95% chance to gain subscribers each second
    MaxEnergy = 100,
    EnergyDrainSeconds = 1,     -- Energy check interval
    EnergyDrainPerSecond = 1.5, -- -1.5% Energy per second of streaming (~65s stream)
    EnergyRestRecoverySeconds = 1.5, -- Rest recovery: +3% energy every 1.5s when not streaming

    -- Hourly Boost Event Settings
    EventCycleDurationSeconds = 3600,
    EventBoostDurationSeconds = 600,
    EventMoneyMultiplier = 1.5,

    -- Dynamic Viewer Comments
    CommentIntervalMin = 1.5,
    CommentIntervalMax = 3.5,
    MaxChatHistory = 40,

    -- Channel Name Rules
    MinChannelNameLength = 3,
    MaxChannelNameLength = 20,

    -- Streaming Platforms
    Platforms = {
        YouTube = {
            Id = "YouTube",
            Name = "YouTube Live",
            ColorHex = "#FF0000",
            MoneyMultiplier = 1.0,
            HypeMultiplier = 1.0,
            Description = "Balanced revenue and subscriber growth. Best for beginner streamers.",
            RequiresLicense = false,
            LicensePrice = 0,
        },
        Twitch = {
            Id = "Twitch",
            Name = "Twitch",
            ColorHex = "#9146FF",
            MoneyMultiplier = 1.35,
            HypeMultiplier = 1.0,
            Description = "Higher donation culture! +35% Money earnings per stream second.",
            RequiresLicense = false,
            LicensePrice = 0,
        },
        TikTok = {
            Id = "TikTok",
            Name = "TikTok Live",
            ColorHex = "#00F2FE",
            MoneyMultiplier = 1.0,
            HypeMultiplier = 1.60,
            Description = "Viral recommendation algorithm! +60% Subscriber gain per stream second.",
            RequiresLicense = false,
            LicensePrice = 0,
        },
        MultiStream = {
            Id = "MultiStream",
            Name = "Split Stream (YT+Twitch)",
            ColorHex = "#FFAA00",
            MoneyMultiplier = 1.85,
            HypeMultiplier = 1.50,
            Description = "Split broadcast to YouTube + Twitch simultaneously! +85% Money and +50% Subs bonus! (Robux Exclusive)",
            RequiresLicense = true,
            LicensePrice = 0, -- Robux Exclusive!
        },
    },

    -- Categories (IRL = Phone anywhere, Gaming & Just Chatting = PC Battlestation)
    Categories = {
        IRL = {
            Id = "IRL",
            Name = "📱 IRL",
            Device = "Phone",
            Description = "Mobile stream on phone! Roam anywhere in the city.",
            Icon = "📱",
            ColorHex = "#00F2FE",
            MoneyMultiplier = 1.0,
            HypeMultiplier = 1.35,
            RequiresPC = false,
        },
        Gaming = {
            Id = "Gaming",
            Name = "🎮 Gaming",
            Device = "PC",
            Description = "Stream PC games at your Battlestation desk! +Bonus from Steam games.",
            Icon = "🎮",
            ColorHex = "#9B51E0",
            MoneyMultiplier = 1.35,
            HypeMultiplier = 1.15,
            RequiresPC = true,
        },
        JustChatting = {
            Id = "JustChatting",
            Name = "🎙️ Just Chatting",
            Device = "PC",
            Description = "Talk show at your computer desk! High community donations and superchats.",
            Icon = "🎙️",
            ColorHex = "#FF9900",
            MoneyMultiplier = 1.45,
            HypeMultiplier = 1.10,
            RequiresPC = true,
        },
    },

    IRLComments = {
        "Where are you heading today?",
        "Show us the car!!",
        "Burger Mart mukbang stream??",
        "Nice weather out there!",
        "Watch the street lol",
        "IRL streams are so entertaining!",
    },

    GamingComments = {
        "POG play!!",
        "Insane clutch bro!",
        "What rank are you in this game?",
        "240 FPS looks buttery clean!",
        "Nice gameplay!",
        "Streamer cracked at games!",
    },

    JustChattingComments = {
        "Deep thoughts today!",
        "Facts, speak on it!",
        "LMAO so true!",
        "Read my superchat please!!",
        "Best podcast / talk show!",
        "Sending $5 for the great advice!",
    },

    -- Dynamic Comments based on Streamer Status
    ViewerComments = {
        "hello streamer!",
        "what are we doing today?",
        "clip that!!",
        "drop some hype in chat!",
        "W stream!",
        "greeting from Ukraine!",
        "let's gooooo!",
        "subbed!!",
    },

    NoGameComments = {
        "bro buy some games from CyberByte Tech lol",
        "streamer has 0 games installed ResidentSleeper",
        "play BlockCraft please!",
        "why we just sitting in an empty room?",
        "buy a Steam game bro",
    },

    LowEnergyComments = {
        "streamer looks so tired lmao",
        "bro go to Burger Mart and eat something!",
        "get an energy drink stat!",
        "he's gonna pass out on keyboard",
        "energy is on 5% lol",
    },

    ProComments = {
        "THIS SETUP IS INSANE!",
        "Take my donation! $10 well deserved!",
        "Best streamer on the platform!",
        "Top 1 Wall of Fame incoming!",
        "240 FPS looking buttery smooth!",
        "The graphics and mic are so crisp!",
    },

    ViewerNames = {
        "GamerX_99",
        "PixelNinja",
        "ShadowRider",
        "NeonValkyrie",
        "TurboSlayer",
        "CoolGuy_UA",
        "CyberWolf",
        "StarWatcher",
        "RoboFanatic",
        "GlitchMaster",
        "Vortex99",
        "EchoStream",
    },

    Rebirth = {
        BaseRequiredSubs = 100,      -- 100 subs for first rebirth (takes ~20s of streaming)
        BaseRequiredMoney = 50,      -- $50 cash for first rebirth
        MultiplierPerRebirth = 0.50, -- +50% permanent boost per rebirth
        StarterCashBonusPerRebirth = 50, -- +$50 extra starting money per rebirth
        MaxEnergyBonusPerRebirth = 10,   -- +10 max energy capacity per rebirth
    },
}

function StreamConfig.GetRebirthRequirements(currentRebirths: number): (number, number)
    local r = currentRebirths or 0
    local scale = math.pow(1.5, r)
    local reqSubs = math.floor(StreamConfig.Rebirth.BaseRequiredSubs * scale)
    local reqMoney = math.floor(StreamConfig.Rebirth.BaseRequiredMoney * scale)
    return reqSubs, reqMoney
end

return StreamConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_StreamEventsConfig">
				<Properties>
					<string name="Name">StreamEventsConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict

export type EventChoice = {
    Id: string,
    Text: string,
    SuccessChance: number,          -- 0.0 to 1.0
    SuccessHypeMultiplier: number,  -- e.g. 0.10 = +10% of total subs
    FailHypeMultiplier: number,     -- e.g. -0.05 = -5% of total subs
    MoneyReward: number,
    SuccessMessage: string,
    FailMessage: string,
}

export type StreamEvent = {
    Id: string,
    Title: string,
    Situation: string,
    TimeoutSeconds: number,
    Choices: { EventChoice },
}

local StreamEventsConfig: { StreamEvent } = {
    {
        Id = "ToxicHater",
        Title = "⚠️ Toxic Hater in Chat!",
        Situation = "A toxic viewer writes: 'YOU SUCK AT THIS GAME, UNINSTALL AND GO WORK AT BURGER MART!'",
        TimeoutSeconds = 9,
        Choices = {
            {
                Id = "RoastHater",
                Text = "🔥 Roast them with a sharp joke (+10% / -5% Subs)",
                SuccessChance = 0.75,
                SuccessHypeMultiplier = 0.10, -- 1000 subs -> +100 | 50 subs -> +5
                FailHypeMultiplier = -0.05,   -- 1000 subs -> -50  | 50 subs -> -3
                MoneyReward = 15,
                SuccessMessage = "Chat explodes with laughter: 'SAVAGE W'!",
                FailMessage = "Your joke sounded awkward... Chat spammed 'L'!",
            },
            {
                Id = "IgnoreAndBan",
                Text = "🛡️ Ignore & Silently Ban (+4% Subs Safe)",
                SuccessChance = 1.0,
                SuccessHypeMultiplier = 0.04, -- 1000 subs -> +40 | 50 subs -> +2
                FailHypeMultiplier = 0,
                MoneyReward = 5,
                SuccessMessage = "Clean chat preserved! Viewers respect your calm.",
                FailMessage = "",
            },
        },
    },
    {
        Id = "TrickshotMoment",
        Title = "🎯 High-Stakes Clutch Moment!",
        Situation = "You're in a 1v1 standoff in the final circle! Chat is holding their breath!",
        TimeoutSeconds = 9,
        Choices = {
            {
                Id = "GoFor360",
                Text = "⚡ Attempt a crazy 360 no-scope (+15% / -6% Subs)",
                SuccessChance = 0.65,
                SuccessHypeMultiplier = 0.15, -- 1000 subs -> +150 | 50 subs -> +8
                FailHypeMultiplier = -0.06,   -- 1000 subs -> -60  | 50 subs -> -3
                MoneyReward = 25,
                SuccessMessage = "UNBELIEVABLE CLUTCH! Clip went viral everywhere!",
                FailMessage = "You whiffed completely and fell off the ledge. Oof!",
            },
            {
                Id = "PlaySafe",
                Text = "🛡️ Play corners and take the safe win (+6% Subs)",
                SuccessChance = 1.0,
                SuccessHypeMultiplier = 0.06,
                FailHypeMultiplier = 0,
                MoneyReward = 10,
                SuccessMessage = "Smart tactical victory! Chat celebrates the win.",
                FailMessage = "",
            },
        },
    },
    {
        Id = "DonationPushups",
        Title = "💰 Spicy Donation Pushups Dare!",
        Situation = "A generous viewer donates and writes: 'Do 20 pushups on cam right now or no balls!'",
        TimeoutSeconds = 9,
        Choices = {
            {
                Id = "DoPushups",
                Text = "💪 Drop down and pump out 20 pushups! (+10% / -5% Subs)",
                SuccessChance = 0.85,
                SuccessHypeMultiplier = 0.10,
                FailHypeMultiplier = -0.05,
                MoneyReward = 35,
                SuccessMessage = "Impressive form! The donor dropped an extra \$35 tip!",
                FailMessage = "You gave up at rep 6... Chat is laughing at you!",
            },
            {
                Id = "PolitePass",
                Text = "☕ 'Thanks, but we're here to game!' (+3% Subs)",
                SuccessChance = 1.0,
                SuccessHypeMultiplier = 0.03,
                FailHypeMultiplier = 0,
                MoneyReward = 8,
                SuccessMessage = "Streamer stayed on grind. Small donation received.",
                FailMessage = "",
            },
        },
    },
    {
        Id = "GameCrash",
        Title = "⚡ Game Suddenly Crashed!",
        Situation = "Right during intense gameplay, your screen goes black and the game freezes!",
        TimeoutSeconds = 9,
        Choices = {
            {
                Id = "EntertainChat",
                Text = "🎙️ Tell a hilarious story while rebooting (+10% / -5% Subs)",
                SuccessChance = 0.80,
                SuccessHypeMultiplier = 0.10,
                FailHypeMultiplier = -0.05,
                MoneyReward = 12,
                SuccessMessage = "Story was so funny nobody even noticed the crash!",
                FailMessage = "Story dragged on and viewers started clicking away...",
            },
            {
                Id = "BlamePC",
                Text = "💻 Rage at PC and swear to upgrade at CyberByte (+5% / -8% Subs)",
                SuccessChance = 0.40,
                SuccessHypeMultiplier = 0.05,
                FailHypeMultiplier = -0.08,
                MoneyReward = 0,
                SuccessMessage = "Your desk slam was turned into a viral meme!",
                FailMessage = "Viewers left due to too much salt in chat!",
            },
        },
    },
    {
        Id = "StreamRaid",
        Title = "🚀 Surprise Stream Raid!",
        Situation = "A famous partner streamer just raided your channel with a wave of viewers!",
        TimeoutSeconds = 9,
        Choices = {
            {
                Id = "HypeSpeech",
                Text = "🎉 Give an energetic welcome speech! (+18% / -5% Subs)",
                SuccessChance = 0.85,
                SuccessHypeMultiplier = 0.18,
                FailHypeMultiplier = -0.05,
                MoneyReward = 30,
                SuccessMessage = "Raiders loved the energy and smashed that follow button!",
                FailMessage = "You panicked and stumbled over words... Raiders left.",
            },
            {
                Id = "PlayCool",
                Text = "😎 Stay chill and casually thank them (+8% Subs)",
                SuccessChance = 1.0,
                SuccessHypeMultiplier = 0.08,
                FailHypeMultiplier = 0,
                MoneyReward = 15,
                SuccessMessage = "Smooth and confident! Respect from the raiding community.",
                FailMessage = "",
            },
        },
    },
}

return StreamEventsConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_ShopConfig">
				<Properties>
					<string name="Name">ShopConfig</string>
					<ProtectedString name="Source"><![CDATA[--!strict

export type ShopCategory = "Gear" | "Game" | "Food" | "License"

